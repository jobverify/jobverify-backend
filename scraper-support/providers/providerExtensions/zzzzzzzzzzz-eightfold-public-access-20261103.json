    "scraperTimeoutMs": 900000,
    "config": {
      "rateLimit": {
        "minimumIntervalMs": 1000,
        "maxRetries": 2,
        "baseDelayMs": 5000,
        "maxDelayMs": 30000
      },
      "discovery": {
        "careerPageUrl": "https://careers.qualcomm.com/careers",
        "listingApiUrl": "https://careers.qualcomm.com/api/pcsx/search"
      },
      "request": {
        "method": "GET",
        "headers": {
          "Accept": "application/json, text/plain, */*",
