          "domain": "qualcomm.com",
          "query": "",
          "location": "India",
          "sort_by": "timestamp"
        }
      },
      "pagination": {
        "strategy": "offset-limit",
        "traversalMode": "staged-snapshot",
        "pageSize": 10,
        "offsetParam": "start",
        "limitParam": "limit",
        "resultsPath": "data.positions",
        "totalCountPath": "data.count"
      },
      "mapping": {
        "title": "name",
        "location": {
          "strategy": "eightfold-location"
        },
        "country": {
          "strategy": "eightfold-country"
        },
        "jobId": "id",
        "requisitionId": "displayJobId",
        "sourceUrl": "positionUrl",
        "applyUrl": "positionUrl",
        "department": "department",
        "postingDate": "postedTs"
      },
      "detail": {
        "enabled": true,
        "requireListingIdentity": true,
        "concurrency": 2,
        "urlTemplate": "https://careers.qualcomm.com/api/pcsx/position_details?position_id={{jobId}}&domain=qualcomm.com&hl=en",
        "method": "GET",
        "headers": {
          "Accept": "application/json, text/plain, */*",
          "Accept-Language": "en-US,en;q=0.9",
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36",
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "https://careers.qualcomm.com/careers?domain=qualcomm.com",
          "Origin": "https://careers.qualcomm.com"
        },
        "mapping": {
          "jobDescription": "data.jobDescription"
        }
      },
      "resultFilter": {
        "include": [
          {
            "field": "country",
            "pattern": "^India$"
          }
        ]
