82</td>\n        <td class=\"job-search-results-department\" id=\"department_1_0_3\">\n          <ul>\n              <li id=\"department_1_0_3_0\" aria-label=\"Department: Finance\">Finance\n</li>          </ul>\n        </td>\n        <td class=\"job-search-results-location\">\n            <ul>\n                <li id=\"location_1_0_3_0\" aria-label=\"Location: Gurgaon, India\">Gurgaon, India</li>\n\n            </ul>\n        </td>\n\n\n\n\n          <td class=\"job-search-results-dropdown_field_1\" id=\"dropdown_field_1_1_0_3\" data-uid=\"d2d369a5b0cd96e552f9d8161e73e27c\" data-option-uid=\"3a7fdf84d342057b473df303d41dd9f5\">\n            Essential(Onsite)\n</td>          <td class=\"job-search-results-dropdown_field_2\" id=\"dropdown_field_2_1_0_3\" data-uid=\"7275c747c9cf338dc707243937e31af6\" data-option-uid=\"037ac877d7b6357bfc383a498523d2f9\">\n            2 - Entry Level\n</td></tr>    <tr role=\"link\" data-action=\"click-&gt;jobs--table-results#navigate\" data-job-url=\"https://careers.bio-rad.com/jobs/trade-compliance-spec-iii-chennai-india\">\n      <td class=\"job-search-results-title\">\n        <a id=\"link_job_title_1_0_4\" aria-label=\"Title: Trade Compliance Spec III\" href=\"https://careers.bio-rad.com/jobs/trade-compliance-spec-iii-chennai-india\">\n          Trade Compliance Spec III\n</a>      </td>\n        <td class=\"job-search-results-requisition-identifiers\" id=\"requisition_identifiers_1_0_4\" aria-label=\"Requisition Identifier: 2026-38980\">2026-38980</td>\n        <td class=\"job-search-results-department\" id=\"department_1_0_4\">\n          <ul>\n              <li id=\"department_1_0_4_0\" aria-label=\"Department: Supply Chain\">Supply Chain\n</li>          </ul>\n        </td>\n        <td class=\"job-search-results-location\">\n            <ul>\n                <li id=\"location_1_0_4_0\" aria-label=\"Location: Chennai, India\">Chennai, India</li>\n\n            </ul>\n        </td>\n\n\n\n\n          <td class=\"job-search-resul