  "detailHtml": "<link rel=\"canonical\" href=\"https://www.appinessworld.com/careers/job-details/seo-expert/ \"><main class=\"careers-inner-main\"><h1>SEO Expert</h1><div class=\"location-container\">\n            <div class=\"location\"><span></span></div>\n            <p class=\"loc-display loc-display-based\">Location: <span>Bangalore</span></p>\n            <div class=\"wrapper\">\n                <i class=\"css-clock\"></i>\n                <p class=\"loc-display\">Required Experience: <span>1-4 Years</span></p>\n            </div>\n        </div><div class=\"job-inner-content\">\n            <div class=\"job-title\">\n                <h2>Job Description</h2>\n                <p>1+ years experience in Search Engine Optimization (SEO)\r\nProficiency in MS Excel, PowerPoint, and Word\r\nExperience with website analysis using a variety of analytics tools including Google Analytics as well as internal reporting tool\r\nExperience working with popular Digital Marketing Tools\r\nKnowledge in HTML\r\nPlanning and strategizing Digital Marketing Campaigns\r\nMeasure and report the performance of all digital marketing campaigns, and assess against goals (ROI and KPIs)\r\nIdentify trends and insights, and optimize spend and performance based on the insights\r\n</p>\n            </div>\n            <div class=\"job-roles\" data-aos=\"fade-up-custom\">\n                <h2>Roles & Responsibilities:</h2>\n                <ul>\r\n\t<li>Improve organic search results for desktop and mobile sites on all major search engines.</li>\r\n\t<li>Provide SEO analysis and recommendations in coordination with elements and structure of websites and web</li>\r\n\t<li>Provide recommendations and execute strategies for content development in coordination with SEO goals &ndash; general and keyword-specific</li>\r\n\t<li>Administer search engine programs (XML sitemaps, Google Analytics, webmaster tool purposes for diagnostic reporting on client projects</li>\r\n\t<li>Promote both off-page and on-page activities and also the interactions that build ranking, profile and traffic</li>\r\n\t<li>Analyse and understand web analytics dashboards and draw inferences which help to attain the business goals</li>\r\n\t<li>Monitor and evaluate search results and search performance across the major search channels, need to have good knowledge of current search trends</li>\r\n\t<li>Communication with team and management on project development, timelines, and results</li>\r\n\t<li>Work closely with the other team members to meet client goals</li>\r\n</ul>\r\n            </div>\n            <div class=\"job-requirements\" data-aos=\"fade-up-custom\">\n                <h2>Pre Requisites:</h2>\n                <ul>\r\n\t<li><strong>Experience</strong>:&nbsp;1 to 3 Years</li>\r\n\t<li><strong>Qualification</strong>:&nbsp;Graduate, Post Graduate</li>\r\n</ul>\r\n            </div>\n\n                        <div class=\"job-skills\" data-aos=\"fade-up-custom\">\n                <h2>Skills:</h2>\n                                                        <div class=\"job-details-progress\">\n                        <div><p>Keyword Research</p></div>\n                        <div><progress value=\"5\" max=\"5\"></progress></div>\n                    </div>\n                                                                            <div class=\"job-details-progress\">\n                        <div><p>Web Analytics</p></div>\n                        <div><progress value=\"5\" max=\"5\"></progress></div>\n                    </div>\n                                                                            <div class=\"job-details-progress\">\n                        <div><p>SEM</p></div>\n                        <div><progress value=\"5\" max=\"5\"></progress></div>\n                    </div>\n                                                                            <div class=\"job-details-progress\">\n                        <div><p>SEO</p></div>\n                        <div><progress value=\"5\" max=\"5\"></progress></div>\n                    </div>\n                                                                            <div class=\"job-details-progress\">\n                        <div><p>Client Servicing</p></div>\n                        <div><progress value=\"3\" max=\"5\"></progress></div>\n                    </div>\n                                                </div>\n            \n            <p id=\"myBtnjobs\" onclick=\"openJobModal()\" class=\"job-apply\">Apply</p>\n        </div><div><div id=\"myModaljobs\" class=\"modal\" style=\"display:none;\"><form id=\"jobApplicationForm\"><input type=\"hidden\" id=\"job-id\" value=\"4\"></form></div></div></main><script src=\"https://www.appinessworld.com/assets/js/job-detalis-inner.min.js\"></script><script type=\"application/ld+json\">\r\n{\r\n    \"@context\": \"https://schema.org/\",\r\n    \"@type\": \"JobPosting\",\r\n    \"title\": \"SEO Expert | SEO Jobs\",\r\n    \"description\": \"Explore SEO jobs at Appiness World: Boost your career with exciting opportunities. Apply now!\",\r\n    \"datePosted\": \"2024-05-31\",\r\n    \"identifier\": {\r\n        \"@type\": \"PropertyValue\",\r\n        \"name\": \"Google\",\r\n        \"value\": \"1234567\"\r\n    },\r\n    \"hiringOrganization\": {\r\n        \"@type\": \"Organization\",\r\n        \"sameAs\": \"https://appinessworld.com/\",\r\n        \"name\": \"Appiness World\"\r\n    },\r\n    \"jobLocation\": {\r\n        \"@type\": \"Place\",\r\n        \"address\": {\r\n            \"@type\": \"PostalAddress\",\r\n            \"streetAddress\": \"406, 24th Cross Rd, Siddanna Layout\",\r\n            \"addressLocality\": \"Banashankari Stage II\",\r\n            \"addressRegion\": \"Bengaluru\",\r\n            \"postalCode\": \"560070\",\r\n            \"addressCountry\": \"India\"\r\n        }\r\n    }\r\n}\r\n</script>"
