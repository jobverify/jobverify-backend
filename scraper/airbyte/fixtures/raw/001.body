              <tr>
                <td valign="middle" width="30%" style="border-collapse: collapse;mso-table-lspace: 0;mso-table-rspace: 0;">
                  <a href="https://docs.airbyte.io/tutorials/adding-incremental-sync">
                    <img src="https://airbyte.io/wp-content/uploads/2021/03/Add-incremental-to-a-source.jpg" alt="" style="width: 100%;max-width: 220px;height: auto;margin: auto;display: block;border-radius: 8px;vertical-align: top;box-shadow: 2px 2px 2px 0px #DFDFDF;border: 0;line-height: 100%;outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;"></a>
