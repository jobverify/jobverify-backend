:host(.dg-consent-banner) {
  --dg-primary-font: ${re};
  --dg-secondary-font: ${re};
  --dg-language-dropdown-font-color: ${s};
  --dg-consent-background-color: ${n};
  --dg-consent-background-border: ${r};
  --consent-border-radius: 0.875rem;
  --dg-body-font-size: 0.8125rem;
  --dg-body-font-weight: 400;
  --dg-body-font-color: ${i};
  --dg-body-line-height: 1.5;
  --dg-heading-font-size: 1.125rem;
  --dg-heading-font-weight: 500;
  --dg-heading-font-color: ${a};
  --dg-heading-line-height: 1.3;
  --dg-title-font-size: 1.125rem;
  --dg-title-font-weight: 500;
  --dg-title-font-color: ${a};
  --dg-title-line-height: 1.3;
  --dg-policy-option-heading-size: 0.875rem;
  --dg-policy-option-heading-weight: 500;
  --dg-policy-option-heading-color: ${a};
  --dg-policy-option-heading-enabled-color: ${ee};
  --dg-policy-option-description-font-size: 0.8125rem;
  --dg-policy-option-description-font-weight: 400;
  --dg-policy-option-description-font-color: ${o};
  --dg-policy-option-essential-label-font-size: 0.75rem;
  --dg-policy-option-essential-label-font-weight: 400;
  --dg-policy-option-essential-label-font-color: ${o};
  --dg-slider-primary: ${x};
  --dg-slider-secondary: ${S};
  --dg-slider-enabled-primary: #5653d9;
  --dg-slider-enabled-secondary: #ffffff;
  --dg-button-font-size: 0.8125rem;
  --dg-button-font-weight: 500;
  --dg-button-color: #ffffff;
  --dg-button-background: ${m};
  --dg-button-border: 1px solid ${m};
  --dg-button-radius: ${te};
}

:host(.dg-consent-banner) .dg-app {
  position: relative;
  box-sizing: border-box;
  font-family: ${re};
  box-shadow: ${ne};
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  /* DataGrail sets overflow:auto + max-height on .dg-app; that clips the
   * absolutely positioned language menu (~220px) against the banner box. */
  overflow: visible;
}

/*
 * One header row: language on the left edge, close X on the right.
 * Keep it in flow so the X does not overlay the first line of copy.
 * Header must accept pointer events so the dropdown can open.
 */
:host(.dg-consent-banner) .dg-header {
  position: relative !important;
  top: auto;
  right: auto;
  left: auto;
  z-index: 2;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin: 0;
  padding: 0 0 20px;
  pointer-events: auto;
  overflow: visible;
}

:host(.dg-consent-banner) .dg-main-language-dropdown {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  margin: 0;
  flex: 0 0 auto;
  align-self: center;
  color: ${s};
  pointer-events: auto;
  overflow: visible;
}

:host(.dg-consent-banner) .dg-header-buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: static;
  margin: 0;
  margin-left: auto;
  flex: 0 0 auto;
  align-self: center;
}

/* Keep the notice flush under the close row — no leftover 4px pad. */
:host(.dg-consent-banner) .dg-main-content-explanation {
  padding-top: 0;
  margin-top: 0;
}

/* Paragraph / rich-text body — DataGrail defaults this to --dg-secondary-font.
 * Full content width matching CTAs once the close band has cleared the X.
 * Justify so line ends meet the same right edge as Accept/Reject. */
:host(.dg-consent-banner) .dg-main-content-explanation,
:host(.dg-consent-banner) .dg-main-content-explanation > *,
:host(.dg-consent-banner) .dg-main-content-explanation p,
:host(.dg-consent-banner) .dg-text-body {
  font-family: ${re};
  color: ${i};
  width: 100%;
  max-width: none;
  box-sizing: border-box;
  padding-top: 0;
  padding-right: 0;
  margin-top: 0;
  margin-right: 0;
  text-align: justify;
  text-align-last: left;
  hyphens: auto;
}

:host(.dg-consent-banner) .dg-main-content-explanation a,
:host(.dg-consent-banner) .dg-link,
:host(.dg-consent-banner) .dg-main-content-policy-option-description a {
  color: ${f};
  text-decoration: underline;
  text-underline-offset: 2px;
}

:host(.dg-consent-banner) .dg-main-content-explanation a:hover,
:host(.dg-consent-banner) .dg-link:hover,
:host(.dg-consent-banner) .dg-main-content-policy-option-description a:hover {
  color: ${p};
}

/* Preference / categories layer — override DataGrail's default light list panel. */
:host(.dg-consent-banner) .dg-main-content-policies {
  background: ${C};
  border: ${w};
  border-radius: ${te};
  color: ${a};
}

:host(.dg-consent-banner) .dg-main-content-policy-option {
  background: transparent;
  border-color: ${T};
  color: ${a};
}

:host(.dg-consent-banner) .dg-main-content-policy-option-heading {
  color: ${a};
}

:host(.dg-consent-banner) .dg-main-content-policy-option-heading strong {
  color: ${a};
}

:host(.dg-consent-banner)
  .dg-main-content-policy-option.dg-enabled:not(.dg-essential)
  .dg-main-content-policy-option-heading,
:host(.dg-consent-banner)
  .dg-main-content-policy-option.dg-enabled:not(.dg-essential)
  .dg-main-content-policy-option-heading strong {
  color: ${ee};
}

:host(.dg-consent-banner) .dg-main-content-policy-option-heading svg,
:host(.dg-consent-banner) .dg-main-content-policy-option-heading svg * {
  fill: ${o};
  stroke: ${o};
  color: ${o};
}

:host(.dg-consent-banner) .language-dropdown-trigger {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  height: 2rem;
  min-height: 2rem;
  padding: 0 0.5rem;
  font-family: ${re};
  color: ${s};
  border: 1px solid ${t?`#383838`:`#e6e6e6`};
  border-radius: ${te};
  background: ${t?`#0a0a0a`:`#ffffff`};
  pointer-events: auto;
  cursor: pointer;
}

:host(.dg-consent-banner) .language-dropdown-trigger > span,
:host(.dg-consent-banner) .language-dropdown-menu button > span {
  font-family: ${re};
  color: ${s};
}

:host(.dg-consent-banner) .dg-main-language-dropdown svg,
:host(.dg-consent-banner) .dg-main-language-dropdown svg * {
  fill: ${s};
  stroke: ${s};
  color: ${s};
}

:host(.dg-consent-banner) .language-dropdown-menu {
  background: ${n};
  border: ${r};
  border-radius: ${te};
  box-shadow: ${ne};
}

:host(.dg-consent-banner) .language-dropdown-menu:not(.hidden) {
  z-index: 30;
  pointer-events: auto;
}

:host(.dg-consent-banner) .language-dropdown-menu button {
  background: ${n};
  color: ${s};
}

:host(.dg-consent-banner) .language-dropdown-menu button:hover,
:host(.dg-consent-banner)
  .language-dropdown-menu
  button.language-dropdown-menu-option__focused {
  background: ${t?`rgba(255, 255, 255, 0.06)`:`rgba(93, 81, 213, 0.08)`};
}

:host(.dg-consent-banner) .dg-button {
  font-family: Fragmentmono, Arial, sans-serif;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition:
    border-color 0.15s ease,
    background-color 0.15s ease,
    color 0.15s ease;
}

:host(.dg-consent-banner) .dg-button.accept_all,
:host(.dg-consent-banner) .dg-button.accept_some,
:host(.dg-consent-banner) .dg-button.custom {
  background: ${m};
  border: 1px solid ${m};
  color: #ffffff;
}

:host(.dg-consent-banner) .dg-button.accept_all:hover,
:host(.dg-consent-banner) .dg-button.accept_some:hover,
:host(.dg-consent-banner) .dg-button.custom:hover {
  background: ${h};
  border-color: ${h};
  color: #ffffff;
}

:host(.dg-consent-banner) .dg-button.reject_all {
  background: ${_};
  border: 1px solid ${g};
  color: ${v};
}

:host(.dg-consent-banner) .dg-button.reject_all:hover {
  border-color: ${y};
  color: ${b};
}

:host(.dg-consent-banner) .dg-button.open_layer {
  font-family: Fragmentmono, Arial, sans-serif;
  font-size: 13px;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: -0.13px;
  background: transparent;
  border: none;
  color: ${o};
  padding: 0;
  box-shadow: none;
}

:host(.dg-consent-banner) .dg-button.open_layer:hover {
  color: ${t?`#d0d0d0`:m};
  background: ${t?`rgba(255, 255, 255, 0.04)`:`rgba(93, 81, 213, 0.08)`};
}

/* Soft site-style X — hide DataGrail's filled Material clear glyph. */
:host(.dg-consent-banner) .dg-header-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: static !important;
  top: auto;
  right: auto;
  width: 2rem;
  height: 2rem;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999px;
  color: ${c};
  opacity: 1;
  cursor: pointer;
  background: transparent ${u} center / 1.125rem no-repeat;
}

:host(.dg-consent-banner) .dg-header-close svg {
  display: none !important;
}

:host(.dg-consent-banner) .dg-header-close:hover {
  color: ${l};
  background-color: ${t?`rgba(255, 255, 255, 0.08)`:`rgba(0, 0, 0, 0.06)`};
  background-image: ${d};
  background-position: center;
  background-size: 1.125rem;
  background-repeat: no-repeat;
}

:host(.dg-consent-banner) .dg-button:focus-visible,
:host(.dg-consent-banner) .dg-link:focus-visible {
  outline: 2px solid #433bfb;
  outline-offset: 2px;
}
