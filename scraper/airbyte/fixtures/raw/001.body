nent:l(()=>_(()=>import(`./app~mcp~index-DyGV22wU.js`).then(e=>e.t),__vite__mapDeps([32,1,4,22,33,9,34,8,10,11,35,12,36,25,26,27,2,16,17,5,18,37,13,14,38,39,40,41,42,43])),`component`)}),lT=f(`/mcp-gateway`)({beforeLoad:()=>{throw u({to:`/mcp`,replace:!0,statusCode:301})}}),uT=f(`/platform`)({beforeLoad:()=>{throw u(Gx(`/platform`))}}),dT=`Compare Airbyte data replication pricing: Standard, Plus, Pro and Enterprise Flex plans with flexible, predictable billing.`,fT={canonical:`${M.origin}/pricing`,title:`Airbyte Pricing | Open-Source Data Integration & AI Context`,description:dT,ogTitle:`Airbyte Pricing | Open-Source Data Integration & AI Context`,ogDescription:dT,twitterTitle:`Airbyte Pricing | Open-Source Data Integration & AI Context`,twitterDescription:dT,ogImage:M.ogImage,twitterImage:M.ogImage},pT=[{question:`What are credits?`,answer:`Airbyte credits are used to pay for Airbyte resources when you run a sync. Credits are used to unify pricing across multiple types of sources. Credit metering differs across source types, and for more details on this, please consult our documentation at https://docs.airbyte.com/platform/cloud/managing-airbyte-cloud/manage-credits.`},{question:`When should I use Plus, and when should I use Standard?`,answer:`If you are consuming 40+ credits a month, Plus will typically be more affordable than Standard. It also comes with 15-min syncs, SSO, field renaming, and a 24 hr support SLA. If you value pay-as-you-go flexibility above all, Standard is the best play.`},{question:`What plans does Airbyte offer, and how do they differ?`,answer:`Airbyte offers Standard, Plus, Pro, and Enterprise Flex. Standard is fully managed volume-based cloud. Plus includes everything in Standard, plus SSO, field renaming, 15-minute syncs, 2 workspaces, and a 24-hour support SLA, billed through credit packages. Pro features capacity based pricing and enterprise features such as RBAC and multiple workspaces. Enterprise Flex adds in-boundary and hybrid deployment. Click here to scroll up to the comparison matrix.`},{question:`What is capacity-based pricing (Data Workers)?`,answer:`Airbyte's Pro and Enterprise Flex plans are priced by Data Workers, a unit of capacity that powers your pipelines. Several variables determine the cost of a Data Worker, and each one can run multiple syncs concurrently — typically around three at once. This model gives you predictable spend, guaranteed performance, and no charges based on data volume.`},{question:`How is capacity-based pricing different from usage or volume-based?`,answer:`Usage or volume-based pricing bills you by rows, GBs, or events, so costs grow as your data grows — even though not all data is equally valuable. Airbyte uses capacity-based pricing instead, so you control spend up front, avoid surprise bills, and scale only when needed, letting your data grow without inflating your bill.`},{question:`What is the Pro plan?`,answer:`Pro includes everything in Plus, with capacity-based pricing, premium support, and enhanced platform features like RBAC, row filtering, hashing and encryption, and support for multiple data regions. It's built for production workloads that require reliability, control, and guaranteed performance.`},{question:`What is Enterprise Flex?`,answer:`Enterprise Flex is for enterprises that need sovereign data movement inside their own boundary, with deployment options including on-premises and multi-region, plus a hybrid model with an Airbyte managed control plane. It includes all Airbyte Pro features, including premium support.`},{question:`What do you recommend for a small team of 3-4 developers?`,answer:`We typically recommend starting with Standard (fully managed, volume-based) if you want zero infrastructure overhead and pay-as-you-go billing. If your monthly usage is 40+ credits, you should consider Plus as it is more cost effective. Plus also comes with SSO, 15-minute syncs, field renaming, or credit packages. You can always move to Pro or Enterprise Flex as you scale and your needs change.`},{question:`Can Airbyte provide a tailored quote?`,answer:`Yes. Work with our team and we'll provide a tailored quote based on your needs — just reach out to sales.`}],mT=`/assets/pricing-light-theme-Dl4aa3_5.css`,hT=`/assets/pricing-overrides-C5lik7xq.css`,gT=f(`/pricing`)({validateSearch:e=>Ug(e),head:()=>({meta:[{name:`description`,content:fT.description},{property:`og:title`,content:fT.ogTitle},{property:`og:description`,content:fT.ogDescription},{property:`og:image`,content:fT.ogImage},{name:`twitter:title`,content:fT.twitterTitle},{name:`twitter:description`,content:fT.twitterDescription},{name:`twitter:image`,content:fT.twitterImage},{title:fT.title}],links:[G,{rel:`stylesheet`,href:hT},{rel:`stylesheet`,href:mT},{rel:`canonical`,href:fT.canonical}]}),scripts:()=>[...ox(Kw()),...ox(ew(pT)),...XC(`/pricing`)],component:l(()=>_(()=>import(`./app~pricing-CTemgNZh.js`).then(e=>e.t),__vite__mapDeps([173,1,4,12,9,66,10,67,68,22,174,5,93,2,25,26,27,50,51,65,62,63,16,175,176,113,71,72,48,73,177,178,179,180,75,181,52,182,183,184,185,186,135,160,187,188])),`component`)}),_T=f(`/privacy`)({beforeLoad:()=>{throw u({to:`/company/privacy-policy`,replace:!0})}}),vT=f(`/pyairbyte`)({component:l(()=>_(()=>import(`./app~pyairbyte~tutorials~compare.page._pageNumber~compare.index-CSQwTycw.js`).then(e=>e.n),__vite__mapDeps([189,1,4,5,71,9,72,48,50,51,77,12])),`component`)}),yT=()=>_(()=>import(`./app~qlik-oS8bhyL2.js`).then(e=>e.t),__vite__mapDeps([190,1,4,93,2,122,123,9,10,124,125,131,92,61,62,63,23,94,95,97,127,128,129])),bT=ig.seo,xT=f(`/qlik`)({head:()=>({meta:[{name:`description`,content:bT.description},{name:`robots`,content:bT.robots},{property:`og:title`,content:bT.title},{property:`og:description`,content:bT.description},{name:`twitter:title`,content:bT.title},{name:`twitter:description`,content:bT.description},{title:bT.title}],links:[G,{rel:`stylesheet`,href:yS},{rel:`stylesheet`,href:bS},{rel:`canonical`,href:bT.canonical}]}