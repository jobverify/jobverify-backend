                      <td valign="middle" width="30%" style="border-collapse: collapse;mso-table-lspace: 0pt;mso-table-rspace: 0pt;"><a href="https://cloud.airbyte.io/signup">
                        <img src="https://uploads-ssl.webflow.com/605e01bc25f7e19a82e74788/6255f6558b732461c8a75158_AirbyteCloud.png" alt="" style="width: 100%;max-width: 200px;height: auto;margin: auto;display: block;border-radius: 8px;vertical-align: top;box-shadow: 2px 2px 2px 0px #DFDFDF;border: 0;line-height: 100%;outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;"></a>
