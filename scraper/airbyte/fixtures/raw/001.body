                        <img src="https://uploads-ssl.webflow.com/605e01bc25f7e19a82e74788/613bbdffc50d3c74dc5c2a7a_modern%20data%20stack.jpeg" alt="" style="width: 100%;max-width: 220px;height: auto;margin: auto;display: block;border-radius: 8px;vertical-align: top;box-shadow: 2px 2px 2px 0px #DFDFDF;border: 0;line-height: 100%;outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;"></a>
