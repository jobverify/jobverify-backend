            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse;mso-table-lspace: 0;mso-table-rspace: 0;">
              <tr>
                <td valign="middle" width="30%" style="border-collapse: collapse;mso-table-lspace: 0;mso-table-rspace: 0;"><a href="https://airbyte.io/blog/airbyte-is-turning-1">
                  <img src="https://uploads-ssl.webflow.com/605e01bc25f7e19a82e74788/6107c50fa2ebe434f0d3d954_Airbyte_1%20year%20old.png" alt="" style="width: 100%;max-width: 200px;height: auto;margin: auto;display: block;border-radius: 8px;vertical-align: top;box-shadow: 2px 2px 2px 0px #DFDFDF;border: 0;line-height: 100%;outline: none;text-decoration: none;-ms-interpolation-mode: bicubic;"></a>
