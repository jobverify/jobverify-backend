    <script nonce="P0dvfz6GlF7auSAw9ggRne5NXfsJ4YDN-_9zFmcfWZY">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"735d5deb-ba6e-49b2-88ba-5ebdf8d315a0","title":"Senior Software Engineer, Platform Fullstack","departmentName":"Engineering","departmentExternalName":"Engineering","locationName":"San Francisco","locationAddress":null,"workplaceType":"Hybrid","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><p style=\"min-height:1.5em\"></p><h2><strong>The Role:</strong></h2><p style=\"min-height:1.5em\">Every great product is built on a great platform. At Airbyte, the Platform team builds the systems that power every product we ship, including Airbyte Cloud, Airbyte Flex, and Airbyte Agents.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We create the infrastructure, internal tooling, developer platforms, and user-facing product surfaces that allow engineers to build quickly, deploy safely, and operate reliably at scale. Our work spans cloud infrastructure, deployment automation, observability, engineering productivity, and the product experiences that our customers and engineers rely on every day.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">As a Senior Fullstack Engineer on Platform, you'll work across the full stack to build both the internal tools that accelerate engineering and the user-facing features that customers interact with directly. You'll move fluidly between building an internal deployment dashboard and shipping a product feature in Airbyte Cloud.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">This role is ideal for engineers who care about craft across the entire stack, whether the user is an internal engineer or an external customer, and who believe great platform work makes everything around it better.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Do:</strong></h2><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\"><strong>Build Internal Platform Products</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Design and build applications that power Airbyte's engineering platform and product surfaces.</p></li><li><p style=\"min-height:1.5em\">Develop internal dashboards for deployments, infrastructure health, connector operations, and platform performance.</p></li><li><p style=\"min-height:1.5em\">Build and improve user-facing features in Airbyte Cloud and Flex, working closely with product and design.</p></li><li><p style=\"min-height:1.5em\">Create self-service tools that enable engineers to provision infrastructure, manage services, and troubleshoot production systems.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\"><strong>Build Across the Stack</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Build modern React and TypeScript applications backed by scalable backend services.</p></li><li><p style=\"min-height:1.5em\">Design APIs and services that support both internal engineering workflows and customer-facing product features.</p></li><li><p style=\"min-height:1.5em\">Collaborate with Platform Engineers, SREs, Product Engineering, Product Managers, and Designers to ship high-quality software.</p></li><li><p style=\"min-height:1.5em\">Improve the usability and reliability of the systems that power Airbyte's products, for both internal and external users.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\"><strong>Improve Developer Experience</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Build tooling that automates repetitive engineering work and reduces friction across the org.</p></li><li><p style=\"min-height:1.5em\">Improve release workflows, deployment visibility, and operational dashboards.</p></li><li><p style=\"min-height:1.5em\">Contribute to the quality of user-facing product surfaces: performance, accessibility, and reliability.</p></li><li><p style=\"min-height:1.5em\">Help establish engineering standards and reusable platform components.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\"><strong>Drive Operational Excellence</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Build interfaces that improve observability, incident response, and production operations.</p></li><li><p style=\"min-height:1.5em\">Create tools that help engineers and customers understand system health, deployment status, and service reliability.</p></li><li><p style=\"min-height:1.5em\">Improve visibility into platform performance through dashboards, metrics, and reporting.</p></li><li><p style=\"min-height:1.5em\">Continuously identify opportunities to reduce operational toil through automation.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\"><strong>Technical Leadership</strong></p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Mentor engineers through design reviews, architecture discussions, and technical leadership.</p></li><li><p style=\"min-height:1.5em\">Raise the quality bar for frontend architecture, testing, accessibility, and maintainability.</p></li><li><p style=\"min-height:1.5em\">Contribute to platform-wide engineering standards and best practices.</p></li><li><p style=\"min-height:1.5em\">Help shape the future of Airbyte's platform and product engineering.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Need:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">7+ years of experience building production fullstack applications.</p></li><li><p style=\"min-height:1.5em\">Deep expertise with React and TypeScript.</p></li><li><p style=\"min-height:1.5em\">Strong backend engineering experience building APIs and distributed systems.</p></li><li><p style=\"min-height:1.5em\">Experience shipping user-facing SaaS products alongside internal tools, developer platforms, or operational dashboards.</p></li><li><p style=\"min-height:1.5em\">Experience working with product managers and designers to ship customer-facing features.</p></li><li><p style=\"min-height:1.5em\">Familiarity with cloud infrastructure and modern deployment workflows.</p></li><li><p style=\"min-height:1.5em\">Strong product instincts and customer empathy, whether your user is an engineer or an external customer.</p></li><li><p style=\"min-height:1.5em\">Excellent written and verbal communication skills.</p></li><li><p style=\"min-height:1.5em\">A bias toward ownership, automation, and shipping.</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Nice To Have:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Experience with Kubernetes, Docker, Terraform, or cloud infrastructure.</p></li><li><p style=\"min-height:1.5em\">Experience with GitHub Actions, CI/CD pipelines, or developer productivity tooling.</p></li><li><p style=\"min-height:1.5em\">Familiarity with observability platforms such as Grafana, Datadog, or Prometheus.</p></li><li><p style=\"min-height:1.5em\">Experience with Java or Kotlin.</p></li><li><p style=\"min-height:1.5em\">Experience with distributed systems and cloud-native architectures.</p></li><li><p style=\"min-height:1.5em\">Experience building internal engineering tools or developer platforms.</p></li><li><p style=\"min-height:1.5em\">Familiarity with data infrastructure or large-scale SaaS platforms.</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>What Success Looks Like:</strong></h2><p style=\"min-height:1.5em\">Success means the software you build makes both engineers and customers more effective.</p><p style=\"min-height:1.5em\">Engineers deploy with confidence.</p><p style=\"min-height:1.5em\">Infrastructure is easier to understand.</p><p style=\"min-height:1.5em\">Production issues are easier to diagnose.</p><p style=\"min-height:1.5em\">Operational workflows become self-service.</p><p style=\"min-height:1.5em\">Development becomes faster, safer, and more reliable.</p><p style=\"min-height:1.5em\">You'll build software that spans the full spectrum, from internal platforms that multiply engineering velocity to product features that customers use every day.</p><p style=\"min-height:1.5em\"></p><h2><strong>Why This Role Matters:</strong></h2><p style=\"min-height:1.5em\">Platform Engineering is the foundation beneath Airbyte Cloud, Airbyte Flex, and Airbyte Agents. Our mission is to build the infrastructure, tooling, and developer experience that allows every engineering team to deliver reliable software at scale.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">When Platform succeeds, engineers move faster and customers get a better product. You'll help build the systems that let Airbyte focus on what matters most: building the future of data movement and AI.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Location:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Onsite 4 days/week in San Francisco, CA</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">• Flexible PTO with a culture that encourages at least 25 days off annually<br /> • 16 weeks fully paid parental leave for all parents<br /> • Comprehensive medical, dental, and vision coverage for employees and dependents<br /> • 401(k) retirement plan<br /> • Professional development budget, conference sponsorship, and book reimbursement<br /> • Commuter benefits and monthly internet reimbursement</p><p style=\"min-height:1.5em\"> •  Breakfast and lunch in our San Francisco office<br /> • A collaborative, in-person culture focused on learning, growth, and impact</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is an equal opportunity employer that does not discriminate on the basis of actual or perceived race, creed, color, religion, national origin, ancestry, age, physical or mental disability, pregnancy, genetic information, sex, sexual orientation, gender identity or expression, marital status, familial status, domestic violence victim status, veteran or military status, or any other legally recognized protected basis under federal, state or local laws. Pursuant to the San Francisco Fair Chance Ordinance, we will consider for employment qualified applicants with arrest and conviction records.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is committed to providing reasonable accommodations for qualified individuals with disabilities in our job application procedures. Please let us know if you need assistance or accommodations due to a disability.</p>","isListed":true,"isConfidential":false,"teamNames":["Engineering"],"secondaryLocationNames":[],"compensationTierSummary":"$196K – $235K • Offers Equity","compensationTiers":[{"id":"92ca182f-5bf1-45fa-a0f8-5eda23a94b5e","title":null,"tierSummary":"$196K – $235K • Offers Equity","__typename":"JobPostingCompensationTiers"}],"applicationDeadline":null,"compensationTierGuideUrl":null,"scrapeableCompensationSalarySummary":"$196K - $235K","compensationPhilosophyHtml":"<p style=\"min-height:1.5em\">The actual compensation package within the stated range will be based on a combination of factors such as an individual's skills, experience level, location, and other relevant job-related considerations.</p>","applicationLimitCalloutHtml":null,"shouldAskForTextingConsent":true,"shouldAskForWhatsAppConsent":false,"candidateTextingPrivacyPolicyUrl":"https://airbyte.