    <script nonce="LY7CekEQspSOPMLtYcsIyJ43XIHH4WqMbxBpaRUUY14">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"efe55756-f28b-4030-b9a0-539f6c8ed8ff","title":"Engineering Manager, Platform","departmentName":"Engineering","departmentExternalName":"Engineering","locationName":"San Francisco","locationAddress":null,"workplaceType":"Hybrid","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><p style=\"min-height:1.5em\"></p><h2><strong>The Role:</strong></h2><p style=\"min-height:1.5em\">Airbyte is looking for an Engineering Manager, Platform to lead the team responsible for the infrastructure, tooling, and engineering systems that power Airbyte Cloud, Airbyte Flex, and Airbyte Agents.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">As an Engineering Manager on the Platform team, you'll lead the engineers responsible for cloud infrastructure, deployment systems, CI/CD, observability, reliability, and the internal tooling that powers engineering velocity across the company. Your work directly shapes both how fast engineers ship and how customers experience Airbyte. This isn't a keep-the-lights-on role. You'll make real tradeoffs between engineering velocity, customer-facing reliability, and long-term architecture every week, and you'll help define how AI transforms the way we build and operate software.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">This role combines people leadership, technical strategy, operational excellence, and platform thinking. You'll help define how engineering works at Airbyte - not just what we build.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Do:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Lead, mentor, and grow a team of Platform Engineers, Fullstack Engineers, and SREs. Recruit engineers who understand that infrastructure decisions are product decisions.</p></li><li><p style=\"min-height:1.5em\">Own the reliability and operational health of Airbyte's production systems.</p></li><li><p style=\"min-height:1.5em\">Define the roadmap for Airbyte's platform: infrastructure, CI/CD, deployment automation, observability, internal tooling, and the product surfaces built on top of them.</p></li><li><p style=\"min-height:1.5em\">Invest in and drive adoption of AI-powered workflows for debugging, release validation, infrastructure management, and developer productivity, moving past experimentation into real operational leverage.</p></li><li><p style=\"min-height:1.5em\">Lead incident response, run blameless postmortems, and ensure systemic fixes follow every outage. Continuously reduce operational toil through automation.</p></li><li><p style=\"min-height:1.5em\">Build leverage: a week-long task this year should take ten minutes next year.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Success Metrics:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Engineers deploy with confidence and ship faster quarter over quarter.</p></li><li><p style=\"min-height:1.5em\">Platform reliability improves as measured by customer-facing SLAs, not just internal dashboards.</p></li><li><p style=\"min-height:1.5em\">Operational toil decreases through automation, not heroics.</p></li><li><p style=\"min-height:1.5em\">Incidents are detected faster, resolved faster, and the same failure doesn't happen twice.</p></li><li><p style=\"min-height:1.5em\">Your team is engaged, growing, and building careers they're proud of.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Need:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">5+ years of software engineering experience, 2+ years managing engineering teams.</p></li><li><p style=\"min-height:1.5em\">Experience leading Platform Engineering, Infrastructure, SRE, or Developer Productivity organizations.</p></li><li><p style=\"min-height:1.5em\">Strong understanding of cloud infrastructure, CI/CD, observability, and distributed systems.</p></li><li><p style=\"min-height:1.5em\">Experience operating production systems at scale.</p></li><li><p style=\"min-height:1.5em\">You think about platform work in terms of customer impact, not just engineering elegance.</p></li><li><p style=\"min-height:1.5em\">You've navigated the tension between paying down tech debt and shipping product, and you can articulate how you made those calls.</p></li><li><p style=\"min-height:1.5em\">Excellent communication skills. You can translate platform strategy into language that product, design, and business leaders understand.</p></li><li><p style=\"min-height:1.5em\">You have an insatiable desire to ship.</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Nice To Have:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Experience with AI-assisted engineering workflows or agentic software development.</p></li><li><p style=\"min-height:1.5em\">Experience building internal developer platforms.</p></li><li><p style=\"min-height:1.5em\">Familiarity with Terraform, Helm, Kubernetes, GitHub Actions, and cloud-native infrastructure.</p></li><li><p style=\"min-height:1.5em\">Experience with data infrastructure, ETL/ELT, or large-scale distributed systems.</p></li><li><p style=\"min-height:1.5em\">Experience contributing to open-source engineering organizations.</p></li><li><p style=\"min-height:1.5em\">Familiarity with Airbyte, connector ecosystems, or developer tooling platforms.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Why This Role Matters:</strong></h2><p style=\"min-height:1.5em\">Platform Engineering is the force multiplier for every engineering team at Airbyte.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Your mission is to build the systems, tooling, and infrastructure that enable engineers to move faster while making our platform more reliable, secure, and scalable. Success means every deployment becomes safer, every incident becomes easier to resolve, every engineer becomes more productive, and AI becomes a natural part of how software is built.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">The best platform teams are invisible—they make everyone else dramatically more effective. That's the team you'll build.</p><p style=\"min-height:1.5em\"></p><h2><strong>Location:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Onsite 4 days/week in San Francisco, CA</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">• Flexible PTO with a culture that encourages at least 25 days off annually<br /> • 16 weeks fully paid parental leave for all parents<br /> • Comprehensive medical, dental, and vision coverage for employees and dependents<br /> • 401(k) retirement plan<br /> • Professional development budget, conference sponsorship, and book reimbursement<br /> • Commuter benefits and monthly internet reimbursement</p><p style=\"min-height:1.5em\"> •  Breakfast and lunch in our San Francisco office<br /> • A collaborative, in-person culture focused on learning, growth, and impact</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is an equal opportunity employer that does not discriminate on the basis of actual or perceived race, creed, color, religion, national origin, ancestry, age, physical or mental disability, pregnancy, genetic information, sex, sexual orientation, gender identity or expression, marital status, familial status, domestic violence victim status, veteran or military status, or any other legally recognized protected basis under federal, state or local laws. Pursuant to the San Francisco Fair Chance Ordinance, we will consider for employment qualified applicants with arrest and conviction records.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is committed to providing reasonable accommodations for qualified individuals with disabilities in our job application procedures. Please let us know if you need assistance or accommodations due to a disability.</p>","isListed":true,"isConfidential":false,"teamNames":["Engineering"],"secondaryLocationNames":[],"compensationTierSummary":"$217K – $260K • Offers Equity","compensationTiers":[{"id":"e36f84b0-da57-4a33-bd3d-ba9d3924a3dc","title":null,"tierSummary":"$217K – $260K • Offers Equity","__typename":"JobPostingCompensationTiers"}],"applicationDeadline":null,"compensationTierGuideUrl":null,"scrapeableCompensationSalarySummary":"$217K - $260K","compensationPhilosophyHtml":"<p style=\"min-height:1.5em\">The actual compensation package within the stated range will be based on a combination of factors such as an individual's skills, experience level, location, and other relevant job-related considerations.</p>","applicationLimitCalloutHtml":null,"shouldAskForTextingConsent":true,"shouldAskForWhatsAppConsent":false,"candidateTextingPrivacyPolicyUrl":"https://airbyte.com/company/privacy-policy","candidateTextingTermsAndConditionsUrl":null,"legalEntityNameForTextingConsent":"Airbyte, Inc","automatedProcessingLegalNotice":null,"__typename":"JobPostingDetails"},"jobBoard":null,"routerPrefix":"/","recaptchaPublicSiteKey":"6LeFb_YUAAAAALUD5h-BiQEp8JaFChe0e0A6r49Y","recaptchaUniversalPublicSiteKey":"6LezdY0tAAAAAEnollNLCAI0z1VDGwM7AzGrU4XZ"};
      // A Vite manifest key: the entry's HTML filename relative to the build root.
      // Single-entry apps leave entryHtml unset.
      const ENTRY_KEY = "index.html";
      fetch("https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/.vite/manifest.json").then(function (res) { return res.json() }).then(function (manifest) {
        const entryData = manifest[ENTRY_KEY];
        if (entryData == null) {
          throw new Error("Vite manifest is missing entry: " + ENTRY_KEY);
        }
    
        // Walk the entry's static imports transitively. Both the CSS and the JS a
        // page needs can sit on shared chunks rather than on the entry record, and
        // the manifest lists only each chunk's direct imports -- so reading the
        // entry alone silently drops stylesheets and preloads. Depth-first
        // post-order puts a dependency's CSS ahead of its importer's, which is the
        // cascade order Vite uses in the HTML it generates for the same entry.
        const chunks = [];
        const visited = {};
        function collectChunks(key) {
          if (visited[key] === true) {
            return;
          }
          visited[key] = true;
          const chunk = manifest[key];
          if (chunk == null) {
            return;
          }
          (chunk.imports ?? []).forEach(collectChunks);
          chunks.push(chunk);
        }
        collectChunks(ENTRY_KEY);
    
        // css[] holds output paths, not digests, but every manifest record carries
        // an integrity for its own file -- so a stylesheet Vite emitted as its own
        // record can be matched by path. The entry's CSS has no record and loads
        // unhashed.
        const integrityByFile = {};
        Object.keys(manifest).forEach(function (key) {
          const record = manifest[key];
          if (record != null && record.file != null && record.integrity != null) {
            integrityByFile[record.file] = record.integrity;
          }
        });
    
        const sheets = [];
        const seenSheets = {};
        chunks.forEach(function (chunk) {
          (chunk.css ?? []).forEach(function (sheet) {
            if (seenSheets[sheet] === true) {
              return;
            }
            seenSheets[sheet] = true;
            sheets.push(sheet);
          });
        });
    
        let bundleLoaded = false;
        function loadBundle() {
          if (bundleLoaded === true) {
            return;
          }
    
          const el = document.createElement("script");
          el.setAttribute("type", "module");
          el.setAttribute("crossorigin", "");
          el.setAttribute("integrity", entryData.integrity);
          el.setAttribute("src", "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + entryData.file);
          document.head.appendChild(el);
          bundleLoaded = true;
        }
    
        chunks.forEach(function (chunk) {
          const preload = document.createElement("link");
          preload.rel = "modulepreload";
          preload.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + chunk.file;
          // Carry the SRI hash on the preload too: Chrome/Firefox reuse the
          // preloaded bytes for the integrity-bearing script tag, so an integrity-less
          // preload silently bypasses the SRI check. Without it here, SRI is never
          // enforced on the code-split chunks (the bulk of the app), in any browser.
          preload.setAttribute("integrity", chunk.integrity);
          preload.setAttribute("crossorigin", "");
          document.head.appendChild(preload);
        });
    
        if (sheets.length > 0) {
          const loadedSheets = [];
          sheets.forEach(function (sheet) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.type = "text/css";
            link.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + sheet;
            link.media = "all";
            const sheetIntegrity = integrityByFile[sheet];
            if (sheetIntegrity != null) {
              link.setAttribute("integrity", sheetIntegrity);
              // SRI on a cross-origin stylesheet requires CORS mode; the CDN sends
              // access-control-allow-origin: *.
              link.setAttribute("crossorigin", "");
            }
            link.onload = function () {
              loadedSheets.push(sheet);
              if (loadedSheets.length === sheets.length) {
                loadBundle();
              }
            };
            link.onerror = loadBundle;
            document.head.insertBefore(link, document.getElementById("vite-preload"));
          });
        } else {
          loadBundle();
        }
      });
    </script>  </body>
