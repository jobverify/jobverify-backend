2.2045 5.058C12.3021 4.96037 12.4604 4.96037 12.5581 5.058L13.4419 5.94189C13.5396 6.03952 13.5396 6.19781 13.4419 6.29544L8.17678 11.5606C8.07915 11.6582 7.92086 11.6582 7.82323 11.5606L2.55806 6.29544Z" fill="currentColor"></path></svg></div></div></div><a class="navigation_link w-nav-link" href="/connectors">Connectors</a><a href="https://docs.airbyte.com/" target="_blank" rel="noopener noreferrer" class="navigation_link w-nav-link">Docs</a><a class="navigation_link w-nav-link" href="/pricing">Pricing</a></div><div class="navigation_menu-right"><a href="/signin" class="ab-marketing-btn ab-marketing-btn--link-dark max-width-full-tablet">Sign in</a><a href="/company/talk-to-sales" class="ab-marketing-btn ab-marketing-btn--sm ab-marketing-btn--secondary-dark max-width-full-tablet">TALK TO SALES</a><a href="https://cloud.airbyte.com/signup" class="ab-marketing-btn ab-marketing-btn--sm ab-marketing-btn--primary-dark max-width-full-tablet">Try it free</a></div></nav><div class="navigation_menu-button w-nav-button" role="button" tabindex="0" aria-label="menu" aria-controls="w-nav-overlay-main" aria-expanded="false"><div class="menu-icon"><div class="menu-icon_line-top"></div><div class="menu-icon_line-middle"><div class="menu-icon_line-middle-inner"></div></div><div class="menu-icon_line-bottom"></div></div></div></div><div id="w-nav-overlay-main" class="w-nav-overlay" data-wf-ignore="true" aria-hidden="true"></div></div><main class="main-wrapper"><!--$--><div class="careers-page-root ab-dot-grid-hero-page"><section class="ab-marketing-hero-section ab-marketing-hero-section--dark ab-marketing-hero-section--has-video ab-careers-hero" style="--ab-dot-grid-hero-dot-grid:url(&quot;data:image/svg+xml;utf8,%3Csvg%20xmlns%3D&#x27;http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg&#x27;%20width%3D&#x27;7&#x27;%20height%3D&#x27;7&#x27;%3E%3Ccircle%20cx%3D&#x27;3.5&#x27;%20cy%3D&#x27;3.5&#x27;%20r%3D&#x27;0.75&#x27;%20fill%3D&#x27;%231a1a1a&#x27;%2F%3E%3C%2Fsvg%3E&quot;)" aria-labelledby="careers-hero-heading"><div class="ab-dot-grid-hero-video-backdrop" aria-hidden="true"><div class="ab-dot-grid-hero-video-dots"></div><div class="ab-dot-grid-hero-video ab-dot-grid-hero-backdrop-visual"><canvas style="display:block;width:100%;height:100%" aria-hidden="true"></canvas></div><div class="ab-dot-grid-hero-video-fade"></div></div><div class="ab-marketing-hero-section__container"><div class="ab-marketing-container-large"><div class="ab-marketing-hero-section__inner"><div class="ab-marketing-hero-section__tagline"><p class="ab-marketing-tagline text-style-tagline ab-marketing-tagline--align-center">Careers at Airbyte</p></div><div class="ab-marketing-hero-section__intro"><h1 class="ab-marketing-heading-1 ab-marketing-hero-section__heading" id="careers-hero-heading">We are developing the <span class="ab-heading-gradient-text">data and action layer</span> for AI agents.</h1><p class="ab-marketing-hero-section__body text-color-content-muted">Come build the future of context infrastructure with us.</p></div><div class="ab-button-group ab-button-group--center ab-marketing-hero-section__ctas"><a href="#open-roles" class="ab-marketing-btn ab-marketing-btn--md ab-marketing-btn--primary-dark">View open roles</a><a href="#careers-life" class="ab-marketing-btn ab-marketing-btn--md ab-marketing-btn--secondary-dark">Life at Airbyte</a></div></div></div></div></section><section class="ab-marketing-vertical-section ab-marketing-padding-global ab-marketing-vertical-section--left ab-marketing-vertical-section--intro-full-width ab-careers-why"><div class="ab-marketing-vertical-section__shell ab-marketing-container-large"><div class="ab-marketing-vertical-section__intro"><div class="ab-marketing-vertical-section__tagline"><p class="ab-marketing-tagline text-style-tagline ab-marketing-tagline--align-start">Why Airbyte, why now</p></div><div class="ab-marketing-vertical-section__heading-group"><h2 class="ab-marketing-heading-1 text-align-left ab-marketing-vertical-section__heading">What&#x27;s it actually like to <span class="ab-heading-gradient-text">work here?</span></h2></div></div><div class="ab-marketing-vertical-section__content"><div class="ab-careers-why__media"><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/team-photo.avif" sizes="(min-width: 992px) 80rem, 100vw"/><source type="image/webp" srcSet="/images/careers/team-photo.webp" sizes="(min-width: 992px) 80rem, 100vw"/><img src="/images/careers/team-photo.webp" sizes="(min-width: 992px) 80rem, 100vw" alt="Airbyte team collaborating in the San Francisco office" class="ab-careers-why__photo" width="2264" height="1318"/></picture></div><div class="ab-careers-why__cards"><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy"><div class="ab-mcp-gateway-use-case-card_inner"><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">Everyone owns the outcome</h4><p class="ab-mcp-gateway-use-case-card_description">We are a small team in San Francisco, working in person, because the hardest problems get solved faster when we are in the same room. Everyone here takes real ownership, moves with urgency, and holds a high bar for the work and for each other, with our users at the center of every decision. It is a lean team where your work matters and the pace is real.</p></div></div></article><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy"><div class="ab-mcp-gateway-use-case-card_inner"><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">The work is ambitious and meaningful</h4><p class="ab-mcp-gateway-use-case-card_description">AI agents are rapidly becoming the primary consumers of enterprise data. We started in 2020 by bringing data to humans through open source, and grew to 700+ connectors trusted by thousands of companies. Now we are building the context layer that lets agents access that data at production scale. What we build shapes how the next generation of software gets made.</p></div></div></article></div></div></div></section><section class="ab-marketing-vertical-section ab-marketing-padding-global ab-marketing-vertical-section--cta-center ab-marketing-vertical-section--has-video ab-marketing-vertical-section--inset ab-marketing-vertical-section--inset-glow ab-careers-values" style="--ab-inset-glow-stop-1:hsla(245, 27%, 52%, 0.58);--ab-inset-glow-stop-2:hsla(245, 27%, 52%, 0.58);--ab-inset-glow-stop-3:hsla(245, 27%, 52%, 0.58);position:relative;overflow:hidden;--ab-dot-grid-hero-dot-grid:url(&quot;data:image/svg+xml;utf8,%3Csvg%20xmlns%3D&#x27;http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg&#x27;%20width%3D&#x27;7&#x27;%20height%3D&#x27;7&#x27;%3E%3Ccircle%20cx%3D&#x27;3.5&#x27;%20cy%3D&#x27;3.5&#x27;%20r%3D&#x27;0.75&#x27;%20fill%3D&#x27;%231a1a1a&#x27;%2F%3E%3C%2Fsvg%3E&quot;)" aria-labelledby="careers-values-heading"><div class="ab-dot-grid-hero-video-backdrop" aria-hidden="true"><div class="ab-dot-grid-hero-video-dots"></div><div class="ab-dot-grid-hero-video ab-dot-grid-hero-backdrop-visual ab-dot-grid-hero-backdrop-visual--aurora"><div class="ab-hero-aurora-backdrop"><div class="ab-aurora" aria-hidden="true"></div></div></div><div class="ab-dot-grid-hero-video-fade"></div></div><div class="ab-marketing-vertical-section__shell ab-marketing-container-large"><div class="ab-marketing-vertical-section__intro"><div class="ab-marketing-vertical-section__tagline"><p class="ab-marketing-tagline text-style-tagline ab-marketing-tagline--align-center">Our values</p></div><div class="ab-marketing-vertical-section__heading-group"><h2 class="ab-marketing-heading-2 ab-marketing-vertical-section__heading" id="careers-values-heading">How we work</h2></div></div><div class="ab-marketing-vertical-section__content"><ul class="ab-careers-values__grid"><li class="ab-careers-values__grid-item"><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy ab-mcp-gateway-use-case-card--copy-icon"><div class="ab-mcp-gateway-use-case-card_inner"><span class="ab-mcp-gateway-use-case-card_icon" aria-hidden="true"><svg width="0" height="0" class="ab-mcp-gateway-use-case-card_icon-defs" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs><linearGradient id="_R_il3d5a_" x1="36.6673" y1="24.1982" x2="3.33522" y2="23.9951" gradientUnits="userSpaceOnUse"><stop offset="0.00480771" stop-color="var(--figma-gradient-1a, #5D51D5)"></stop><stop offset="1" stop-color="var(--figma-gradient-1b, #CECBF2)"></stop></linearGradient></defs></svg><svg viewBox="0 0 24 24" width="40" height="40" stroke="url(#_R_il3d5a_)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.99c0-.972 0-1.457.202-1.725a1 1 0 0 1 .738-.395c.335-.02.74.25 1.548.788l10.515 7.01c.668.446 1.002.668 1.118.949a1 1 0 0 1 0 .766c-.116.28-.45.503-1.118.948l-10.515 7.01c-.809.54-1.213.809-1.548.789a1 1 0 0 1-.738-.395C5 20.467 5 19.98 5 19.01V4.99Z"></path></svg></span><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">Own the outcome</h4><p class="ab-mcp-gateway-use-case-card_description">We take ownership from end to end, prioritizing outcomes over activity. We act with urgency. We ship, learn, and adjust rather than waiting for perfect answers.</p></div></div></article></li><li class="ab-careers-values__grid-item"><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy ab-mcp-gateway-use-case-card--copy-icon"><div class="ab-mcp-gateway-use-case-card_inner"><span class="ab-mcp-gateway-use-case-card_icon" aria-hidden="true"><svg width="0" height="0" class="ab-mcp-gateway-use-case-card_icon-defs" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs><linearGradient id="_R_kl3d5a_" x1="36.6673" y1="24.1982" x2="3.33522" y2="23.9951" gradientUnits="userSpaceOnUse"><stop offset="0.00480771" stop-color="var(--figma-gradient-1a, #5D51D5)"></stop><stop offset="1" stop-color="var(--figma-gradient-1b, #CECBF2)"></stop></linearGradient></defs></svg><svg viewBox="0 0 24 24" width="40" height="40" stroke="url(#_R_kl3d5a_)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 16A7 7 0 1 0 9 2a7 7 0 0 0 0 14Z"></path><path d="M15 22a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"></path></svg></span><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">All in together</h4><p class="ab-mcp-gateway-use-case-card_description">We work with trust, respect, and shared context. We debate openly, decide quickly at the right level, and execute as one. We commit and support one another.</p></div></div></article></li><li class="ab-careers-values__grid-item"><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy ab-mcp-gateway-use-case-card--copy-icon"><div class="ab-mcp-gateway-use-case-card_inner"><span class="ab-mcp-gateway-use-case-card_icon" aria-hidden="true"><svg width="0" height="0" class="ab-mcp-gateway-use-case-card_icon-defs" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs><linearGradient id="_R_ml3d5a_" x1="36.6673" y1="24.1982" x2="3.33522" y2="23.9951" gradientUnits="userSpaceOnUse"><stop offset="0.00480771" stop-color="var(--figma-gradient-1a, #5D51D5)"></stop><stop offset="1" stop-color="var(--figma-gradient-1b, #CECBF2)"></stop></linearGradient></defs></svg><svg viewBox="0 0 24 24" width="40" height="40" stroke="url(#_R_ml3d5a_)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4V2m0 14v-2M8 9h2m10 0h2m-4.2 2.8L19 13m-1.2-6.8L19 5M3 21l9-9m.2-5.8L11 5"></path></svg></span><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">Execution excellence</h4><p class="ab-mcp-gateway-use-case-card_description">We build scalable systems and continuously improve our work. We optimize for efficiency and stay accountable. Everyone uses AI as a core tool.</p></div></div></article></li><li class="ab-careers-values__grid-item"><article class="ab-mcp-gateway-use-case-card ab-mcp-gateway-use-case-card--copy ab-mcp-gateway-use-case-card--copy-icon"><div class="ab-mcp-gateway-use-case-card_inner"><span class="ab-mcp-gateway-use-case-card_icon" aria-hidden="true"><svg width="0" height="0" class="ab-mcp-gateway-use-case-card_icon-defs" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs><linearGradient id="_R_ol3d5a_" x1="36.6673" y1="24.1982" x2="3.33522" y2="23.9951" gradientUnits="userSpaceOnUse"><stop offset="0.00480771" stop-color="var(--figma-gradient-1a, #5D51D5)"></stop><stop offset="1" stop-color="var(--figma-gradient-1b, #CECBF2)"></stop></linearGradient></defs></svg><svg viewBox="0 0 24 24" width="40" height="40" stroke="url(#_R_ol3d5a_)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 14s1.5 2 4 2 4-2 4-2m1-4.76c-.395.485-.935.76-1.5.76s-1.09-.275-1.5-.76m-4 0c-.395.485-.935.76-1.5.76S7.41 9.725 7 9.24M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2s10 4.477 10 10Z"></path></svg></span><div class="ab-mcp-gateway-use-case-card_copy"><h4 class="ab-marketing-heading-5 ab-mcp-gateway-use-case-card_title">Users first</h4><p class="ab-mcp-gateway-use-case-card_description">We obsess over our users&#x27; success and look for every opportunity to delight them. We prioritize simple, usable solutions rather than over-engineering.</p></div></div></article></li></ul><div class="ab-careers-values__cta"><a href="https://app.notion.com/p/Company-Handbook-External-b69807c0d72646a3b3f58983cc9e522b" class="ab-marketing-btn ab-marketing-btn--md ab-marketing-btn--primary-dark" target="_blank" rel="noopener noreferrer">Read Our Company Handbook</a></div></div></div></section><section id="careers-life" class="ab-marketing-vertical-section ab-marketing-padding-global ab-marketing-vertical-section--cta-center ab-careers-life" aria-labelledby="careers-life-heading"><div class="ab-marketing-vertical-section__shell ab-marketing-container-large"><div class="ab-marketing-vertical-section__intro"><div class="ab-marketing-vertical-section__tagline"><p class="ab-marketing-tagline text-style-tagline ab-marketing-tagline--align-center">Life at Airbyte</p></div><div class="ab-marketing-vertical-section__heading-group"><h2 class="ab-marketing-heading-2 ab-marketing-vertical-section__heading" id="careers-life-heading">We build together, in person</h2><p class="ab-marketing-vertical-section__description text-color-content-muted">Our team works onsite four days a week in San Francisco. We believe great products are built through close collaboration, rapid iteration, and shared ownership. That&#x27;s why we spend most of the week together in person, while keeping Friday an optional work-from-home day to support the balance and autonomy that help exceptional people do their best work.</p></div></div><div class="ab-marketing-vertical-section__content"><div class="ab-careers-life__ticker" aria-label="Team photos"><div class="ab-careers-life__viewport"><div class="ab-careers-life__marquee"><ul class="ab-careers-life__track"><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:-3.75deg;--ab-careers-life-tape-rotate:-5deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Team members at an office event"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-01.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-01.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-01.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Life 01" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:2.5deg;--ab-careers-life-tape-rotate:4deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Airbyte team social gathering"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-02.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-02.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-02.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Life 02" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:-4.25deg;--ab-careers-life-tape-rotate:-6deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Collaborative workspace moment"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-03.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-03.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-03.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Life 03" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:1.85deg;--ab-careers-life-tape-rotate:3deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Team members with a dog in the San Francisco office lounge"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-09.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-09.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-09.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Team members with a dog in the San Francisco office lounge" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:-2.35deg;--ab-careers-life-tape-rotate:-4deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Team lunch outdoors"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-04.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-04.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-04.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Life 04" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:3.6deg;--ab-careers-life-tape-rotate:5deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: Office celebration"><span class="ab-careers-life__tape" aria-hidden="true"></span><picture style="display:block;width:100%"><source type="image/avif" srcSet="/images/careers/life-05.avif" sizes="(min-width: 768px) 22rem, 70vw"/><source type="image/webp" srcSet="/images/careers/life-05.webp" sizes="(min-width: 768px) 22rem, 70vw"/><img src="/images/careers/life-05.webp" sizes="(min-width: 768px) 22rem, 70vw" alt="Life 05" class="ab-careers-life__photo" width="480" height="320" loading="lazy"/></picture></button></li><li class="ab-careers-life__slide" style="--ab-careers-life-rotate:-1.65deg;--ab-careers-life-tape-rotate:-3deg"><button type="button" class="ab-careers-life__polaroid" aria-label="View larger: 