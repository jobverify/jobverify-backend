2257 21.5303 18.965 20.5826 19.2213C17.9071 19.8831 5.92356 19.8015 3.40294 19.2213C2.45524 18.9678 1.71595 18.2257 1.45966 17.278C0.827391 14.7011 0.871044 9.25144 1.44558 6.73081C1.69905 5.78311 2.44116 5.04382 3.38886 4.78753C6.96561 4.0412 19.2956 4.282 20.5686 4.77345ZM9.86682 8.70227L15.6122 11.9974L9.86682 15.2925V8.70227Z" fill="currentColor"></path></svg></div></a></div></div></div></div></div></footer></div><script>;(function(){
function onReady(fn){
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',fn,{once:true});
  else fn();
}
function abWasBooted(el){return !!(el&&el.__abBoot);}
function abMarkBooted(el){if(el)el.__abBoot=1;}
function abClearBooted(el){if(el)delete el.__abBoot;}
function initContextStore(){
  var root=document.querySelector('.section-home_context-store');
  if(!root||abWasBooted(root))return;
  abMarkBooted(root);
  var tabsWrap=root.querySelector('.context-store_tabs-wrapper');
  var tabs=[].slice.call(root.querySelectorAll('.context-store-tab_wrapper'));
  var cards=[].slice.call(root.querySelectorAll('.context-store_image-wrapper'));
  if(!tabs.length||tabs.length!==cards.length)return;
  function isMobile(){return window.matchMedia('(max-width:767px)').matches;}
  function setActive(idx){
    tabs.forEach(function(t,i){
      var circle=t.querySelector('.context-store-tab_circle');
      if(i===idx){t.classList.add('is-active');if(circle)circle.classList.remove('hide');}
      else{t.classList.remove('is-active');if(circle)circle.classList.add('hide');}
    });
    cards.forEach(function(c,i){c.classList.toggle('is-active',i===idx);});
    if(isMobile()&&tabsWrap){
      var activeTab=tabs[idx];
      var tr=activeTab.getBoundingClientRect();
      var wr=tabsWrap.getBoundingClientRect();
      if(!(tr.left>=wr.left&&tr.right<=wr.right)){
        tabsWrap.scrollTo({left:activeTab.offsetLeft+activeTab.offsetWidth/2-tabsWrap.clientWidth/2,behavior:'smooth'});
      }
    }
  }
  var raf=null,lastIdx=-1;
  function compute(){
    raf=null;
    var trigger=window.innerHeight*(isMobile()?0.45:0.38);
    var next=0;
    for(var i=0;i<cards.length;i++){
      var top=cards[i].getBoundingClientRect().top;
      if(top<=trigger)next=i;else break;
    }
    if(next!==lastIdx){lastIdx=next;setActive(next);}
  }
  function onScroll(){if(!raf)raf=requestAnimationFrame(compute);}
  tabs.forEach(function(tab,i){
    tab.addEventListener('click',function(e){
      e.preventDefault();
      var off=window.innerHeight*(isMobile()?0.45:0.38)-8;
      var top=cards[i].getBoundingClientRect().top+window.scrollY-off;
      window.scrollTo({top:top,behavior:'smooth'});
    });
  });
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll);
  compute();
}
function initHomeScrollGradient(){
  /* Owned by ScrollRevealSection → useScrollGradientText (React). */
  return;
}
function syncWfTabs(shell,wTab,linkSel,paneSel){
  shell.querySelectorAll(linkSel).forEach(function(el){
    el.classList.toggle('w--current',el.getAttribute('data-w-tab')===wTab);
  });
  shell.querySelectorAll(paneSel).forEach(function(el){
    el.classList.toggle('w--tab-active',el.getAttribute('data-w-tab')===wTab);
  });
}
function initWebflowTabLinks(){
  document.addEventListener('click',function(e){
    var t=e.target;
    if(!(t instanceof Element))return;
    var link=t.closest('a[data-w-tab].w-tab-link');
    if(!link)return;
    e.preventDefault();
    var shell=link.closest('.w-tabs');
    if(!shell)return;
    var wTab=link.getAttribute('data-w-tab');
    if(!wTab)return;
    syncWfTabs(shell,wTab,'a[data-w-tab].w-tab-link','.w-tab-pane[data-w-tab]');
  },true);
}
function initAgentSdkTabs(){
  var shell=document.querySelector('.layout28_tabs.w-tabs');
  if(!shell||abWasBooted(shell))return;
  abMarkBooted(shell);
  var tabs=[].slice.call(shell.querySelectorAll('[role="tab"].agent-builder_tabs-link'));
  var panes=[].slice.call(shell.querySelectorAll('.agent-builder_tab-pane.w-tab-pane'));
  if(!tabs.length||!panes.length)return;
  function setActive(i){
    tabs.forEach(function(tab,idx){
      var on=idx===i;
      tab.classList.toggle('w--current',on);
      tab.setAttribute('aria-selected',on?'true':'false');
      tab.tabIndex=on?0:-1;
    });
    panes.forEach(function(pane,idx){
      var on=idx===i;
      pane.classList.toggle('w--tab-active',on);
      pane.setAttribute('aria-hidden',on?'false':'true');
    });
  }
  var active=Math.max(0,tabs.findIndex(function(t){return t.classList.contains('w--current');}));
  setActive(active);
  tabs.forEach(function(tab,i){
    tab.addEventListener('click',function(){setActive(i);});
  });
}
function initWfHorizontalSlider(slider,slideSelector,prevSelector,nextSelector){
  if(!slider||abWasBooted(slider))return;
  abMarkBooted(slider);
  var mask=slider.querySelector('.w-slider-mask');
  if(!mask)return;
  var track=mask.firstElementChild;
  if(!track)return;
  var slides=[].slice.call(slider.querySelectorAll(slideSelector)).filter(function(s){return !s.classList.contains('hide');});
  if(!slides.length)return;
  var dots=[].slice.call(slider.querySelectorAll('.w-slider-dot'));
  var index=0,stepPx=0;
  function measure(){
    if(slides.length>=2)stepPx=slides[1].offsetLeft-slides[0].offsetLeft;
    else stepPx=slides[0].offsetWidth;
  }
  function paint(){
    track.style.transform='translate3d('+(-index*stepPx)+'px,0,0)';
    dots.forEach(function(dot,i){dot.classList.toggle('w-active',i===index);dot.setAttribute('aria-current',i===index?'true':'');});
  }
  function go(i){index=(i+slides.length)%slides.length;paint();}
  measure();
  paint();
  var prev=slider.querySelector(prevSelector);
  var next=slider.querySelector(nextSelector);
  if(prev)prev.addEventListener('click',function(){go(index-1);});
  if(next)next.addEventListener('click',function(){go(index+1);});
  dots.forEach(function(dot,i){dot.addEventListener('click',function(){go(i);});});
  if(typeof ResizeObserver==='function'){
    new ResizeObserver(function(){requestAnimationFrame(function(){measure();paint();});}).observe(mask);
  }
}
function initTestimonial28(){
  var slider=document.querySelector('.testimonial28_slider');
  initWfHorizontalSlider(slider,'.testimonial28_slide','.slider-arrow-previous-magenta,.w-slider-arrow-left','.slider-arrow_next-magenta,.w-slider-arrow-right');
}
function initReviewSlider(){
  document.querySelectorAll('.review-slider_slider').forEach(function(slider){
    initWfHorizontalSlider(slider,'.review-slider_slide','.review-slider-arrow.w-slider-arrow-left','.review-slider-arrow.w-slider-arrow-right');
  });
}
function initNewsSlider(){
  document.querySelectorAll('.news-slider_slider').forEach(function(slider){
    if(slider.closest('.reviews-page-root'))return;
    initWfHorizontalSlider(slider,'.news-slider_slide','.news-slider_arrow.w-slider-arrow-left','.news-slider_arrow.w-slider-arrow-right');
  });
}
onReady(function(){
  try{
    initContextStore();
    initHomeScrollGradient();
    initWebflowTabLinks();
    initAgentSdkTabs();
    initTestimonial28();
    initReviewSlider();
    initNewsSlider();
    document.documentElement.__abMarketingInteractions=1;
  }catch(err){console.error('[ab-marketing-interactions]',err);}
});
})();</script><script class="$tsr" id="$tsr-stream-barrier">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:$R[1]={routes:$R[2]={__root__:$R[3]={scripts:$R[4]=[$R[5]={attrs:$R[6]={type:"module",async:!0,src:"/assets/index-eeZtTw76.js"}}],css:$R[7]=["/assets/index-BOl72mkU.css"]},"/company/careers":$R[8]={css:$R[9]=["/assets/app~use-case.page._pageNumber~use-case.index~top-etl-tools-for-sources.page-DWOML0o9.css","/assets/app~dev-Dx7RTX_B.css","/assets/app~careers-DEXX2kth.css"]}}},matches:$R[10]=[$R[11]={i:"__root__␀",u:1793081839437,s:"success",ssr:!0},$R[12]={i:"␀company␀careers␀company␀careers",u:1793081839437,s:"success",ssr:!0}]})($R["tsr"]);$_TSR.e();document.currentScript.remove()</script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://airbyte.com/#organization","name":"Airbyte","alternateName":["Airbyte Inc.","AirbyteHQ"],"url":"https://airbyte.com/","logo":"https://airbyte.com/favicon-512x512.png?v=20260618","description":"Airbyte is the open-source data movement platform. Run ELT pipelines across 700+ connectors to any warehouse, lake, vector database, or AI agent.","sameAs":["https://github.com/airbytehq","https://github.com/airbytehq/airbyte","https://www.linkedin.com/company/airbytehq","https://x.com/airbytehq","https://www.crunchbase.com/organization/airbyte","https://www.g2.com/products/airbyte/reviews","https://www.gartner.com/reviews/product/airbyte","https://www.ycombinator.com/companies/airbyte","https://www.wikidata.org/wiki/Q136502716"]},{"@type":"SoftwareApplication","name":"Airbyte","applicationCategory":"BusinessApplication","applicationSubCategory":"Data Integration","operatingSystem":"Linux, macOS, Windows, Cloud","offers":{"@type":"Offer","url":"