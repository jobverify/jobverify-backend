        </div>
      </div>    </div>
    <script nonce="4gfKVNcGEeSwd7q1ZTL1w9XnXtVJMxZZmY43rG1V8cE">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"5e394a39-58d4-43a6-9ce3-3c009a7362c8","title":"Enterprise Account Executive","departmentName":"Sales","departmentExternalName":"Sales","locationName":"United States","locationAddress":null,"workplaceType":"Remote","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><p style=\"min-height:1.5em\"></p><h2><strong>The Role:</strong></h2><p style=\"min-height:1.5em\">Airbyte is seeking an experienced Enterprise Account Executive to join our growing sales organization. In this role, you will own a defined portfolio of enterprise accounts and be responsible for generating, progressing, and closing new business across Airbyte’s product offerings.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">You will work a mix of qualified inbound opportunities and strategically selected target accounts, while building relationships and creating demand across your territory. You will primarily engage with CTO, CIO, data, and engineering organizations, working with stakeholders ranging from data engineers and architects to senior business and technology executives.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">A successful candidate will be comfortable navigating complex technical environments, leading multi-stakeholder sales processes, and connecting technical capabilities to measurable business outcomes. A foundational understanding of cloud infrastructure, the modern data stack, APIs, data integration, and database replication is strongly preferred. Candidates with a demonstrated ability to quickly learn complex technical concepts will also be considered.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">This is a new-business-focused role. Success will be driven by landing strategic customers, establishing Airbyte within an initial use case, and creating a clear path toward broader adoption across the organization. You will join a fast-growing company with a strong product-led motion, a highly technical customer base, and a significant market opportunity.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Do:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Own the full enterprise sales cycle, from account development and discovery through technical evaluation, proposal, negotiation, procurement, and closed-won.</p></li><li><p style=\"min-height:1.5em\">Build and maintain a healthy pipeline through a combination of qualified inbound opportunities, targeted outbound prospecting, partner engagement, and strategic account development.</p></li><li><p style=\"min-height:1.5em\">Develop trusted relationships across technical, business, and executive stakeholders within enterprise accounts.</p></li><li><p style=\"min-height:1.5em\">Lead effective discovery to uncover customer challenges, business priorities, technical requirements, and decision criteria.</p></li><li><p style=\"min-height:1.5em\">Apply value-selling principles and Airbyte’s sales methodology, including Command of the Message and MEDDPICC, to quantify customer pain, establish urgency, differentiate Airbyte, and maintain control of the sales process.</p></li><li><p style=\"min-height:1.5em\">Build clear and compelling business cases that connect Airbyte’s technical capabilities to measurable customer outcomes.</p></li><li><p style=\"min-height:1.5em\">Partner closely with Solutions Engineering to scope, manage, and successfully complete technical evaluations and proofs of value.</p></li><li><p style=\"min-height:1.5em\">Navigate complex security, legal, procurement, and commercial processes.</p></li><li><p style=\"min-height:1.5em\">Create account strategies that support both initial adoption and long-term expansion.</p></li><li><p style=\"min-height:1.5em\">Maintain accurate opportunity, pipeline, MEDDPICC, and forecast information.</p></li><li><p style=\"min-height:1.5em\">Consistently achieve or exceed quarterly bookings targets.</p></li><li><p style=\"min-height:1.5em\">Collaborate with Product, Marketing, Engineering, Customer Success, and other internal teams to share market feedback, competitive intelligence, customer requirements, and product opportunities.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Need:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">3-5+ years of B2B sales experience within SaaS, cloud infrastructure, developer tools, or data technology, including at least 1-2+ years selling into enterprise accounts.</p></li><li><p style=\"min-height:1.5em\">A demonstrated history of meeting or exceeding quota in a new-business sales role.</p></li><li><p style=\"min-height:1.5em\">Experience managing complex, multi-stakeholder enterprise sales cycles.</p></li><li><p style=\"min-height:1.5em\">Experience using structured enterprise sales methodologies such as Command of the Message, MEDDPICC, and value-based selling.</p></li><li><p style=\"min-height:1.5em\">A proven ability to uncover and quantify business pain, build compelling value propositions, establish urgency, and navigate enterprise decision-making processes.</p></li><li><p style=\"min-height:1.5em\">Confidence engaging both technical practitioners and executive buyers.</p></li><li><p style=\"min-height:1.5em\">The ability to translate complex technical capabilities into clear business value.</p></li><li><p style=\"min-height:1.5em\">Strong prospecting, discovery, presentation, negotiation, and communication skills.</p></li><li><p style=\"min-height:1.5em\">Excellent organization, pipeline management, and forecasting discipline.</p></li><li><p style=\"min-height:1.5em\">Direct experience with data infrastructure, cloud platforms, data integration, or the modern data stack is strongly preferred.</p></li><li><p style=\"min-height:1.5em\">A proactive, curious, accountable, and collaborative working style.</p></li><li><p style=\"min-height:1.5em\">The ability to operate effectively in a fast-paced and evolving environment.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Location:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Remote in U.S. (Central and Eastern timezone)</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Flexible PTO with a culture that encourages at least 25 days off annually, and public holidays in line with provincial employment standards</p></li><li><p style=\"min-height:1.5em\">Comprehensive health coverage – extended health benefits on top of provincial public healthcare</p></li><li><p style=\"min-height:1.5em\">Virtual healthcare – access to doctors and other care providers online, so you can get care without waiting</p></li><li><p style=\"min-height:1.5em\">Retirement savings – a group retirement savings plan to help you build for the future</p></li><li><p style=\"min-height:1.5em\">Statutory protections – Canada/Québec Pension Plan, Employment Insurance and workers' compensation coverage</p></li><li><p style=\"min-height:1.5em\">Professional development budget, conference sponsorship, and book reimbursement</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p>","isListed":true,"isConfidential":false,"teamNames":["Sales"],"secondaryLocationNames":[],"compensationTierSummary":"$212.5K – $300K • Offers Equity • Offers Commission • Multiple Ranges","compensationTiers":[{"id":"640450d4-b652-479a-a95f-19a12fdc8907","title":"Tier 1 - San Francisco, Los Angeles, Seattle, New York City","tierSummary":"OTE $250K – $300K • Offers Equity • Offers Commission","__typename":"JobPostingCompensationTiers"},{"id":"b7722419-49e2-4f1d-9408-d00ae68de756","title":"Tier 2 - All Other U.S. Locations","tierSummary":"OTE $212.5K – $255K • Offers Equity • Offers Commission","__typename":"JobPostingCompensationTiers"}],"applicationDeadline":null,"compensationTierGuideUrl":null,"scrapeableCompensationSalarySummary":"$212.5K - $300K","compensationPhilosophyHtml":"<p style=\"min-height:1.5em\">The actual compensation package within the stated range will be based on a combination of factors such as an individual's skills, experience level, location, and other relevant job-related considerations.</p>","applicationLimitCalloutHtml":null,"shouldAskForTextingConsent":true,"shouldAskForWhatsAppConsent":false,"candidateTextingPrivacyPolicyUrl":"https://airbyte.com/company/privacy-policy","candidateTextingTermsAndConditionsUrl":null,"legalEntityNameForTextingConsent":"Airbyte, Inc","automatedProcessingLegalNotice":null,"__typename":"JobPostingDetails"},"jobBoard":null,"routerPrefix":"/","recaptchaPublicSiteKey":"6LeFb_YUAAAAALUD5h-BiQEp8JaFChe0e0A6r49Y","recaptchaUniversalPublicSiteKey":"6LezdY0tAAAAAEnollNLCAI0z1VDGwM7AzGrU4XZ"};
      // A Vite manifest key: the entry's HTML filename relative to the build root.
      // Single-entry apps leave entryHtml unset.
      const ENTRY_KEY = "index.html";
      fetch("https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/.vite/manifest.json").then(function (res) { return res.json() }).then(function (manifest) {
        const entryData = manifest[ENTRY_KEY];
        if (entryData == null) {
          throw new Error("Vite manifest is missing entry: " + ENTRY_KEY);
        }
    
        // Walk the entry's static imports transitively. Both the CSS and the JS a
        // page needs can sit on shared chunks rather than on the entry record, and
        // the manifest lists only each chunk's direct imports -- so reading the
        // entry alone silently drops stylesheets and preloads. Depth-first
        // post-order puts a dependency's CSS ahead of its importer's, which is the
        // cascade order Vite uses in the HTML it generates for the same entry.
        const chunks = [];
        const visited = {};
        function collectChunks(key) {
          if (visited[key] === true) {
            return;
          }
          visited[key] = true;
          const chunk = manifest[key];
          if (chunk == null) {
            return;
          }
          (chunk.imports ?? []).forEach(collectChunks);
          chunks.push(chunk);
        }
        collectChunks(ENTRY_KEY);
    
        // css[] holds output paths, not digests, but every manifest record carries
        // an integrity for its own file -- so a stylesheet Vite emitted as its own
        // record can be matched by path. The entry's CSS has no record and loads
        // unhashed.
        const integrityByFile = {};
        Object.keys(manifest).forEach(function (key) {
          const record = manifest[key];
          if (record != null && record.file != null && record.integrity != null) {
            integrityByFile[record.file] = record.integrity;
          }
        });
    
        const sheets = [];
        const seenSheets = {};
        chunks.forEach(function (chunk) {
          (chunk.css ?? []).forEach(function (sheet) {
            if (seenSheets[sheet] === true) {
              return;
            }
            seenSheets[sheet] = true;
            sheets.push(sheet);
          });
        });
    
        let bundleLoaded = false;
        function loadBundle() {
          if (bundleLoaded === true) {
            return;
          }
    
          const el = document.createElement("script");
          el.setAttribute("type", "module");
          el.setAttribute("crossorigin", "");
          el.setAttribute("integrity", entryData.integrity);
          el.setAttribute("src", "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + entryData.file);
          document.head.appendChild(el);
          bundleLoaded = true;
        }
    
        chunks.forEach(function (chunk) {
          const preload = document.createElement("link");
          preload.rel = "modulepreload";
          preload.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + chunk.file;
          // Carry the SRI hash on the preload too: Chrome/Firefox reuse the
          // preloaded bytes for the integrity-bearing script tag, so an integrity-less
          // preload silently bypasses the SRI check. Without it here, SRI is never
          // enforced on the code-split chunks (the bulk of the app), in any browser.
          preload.setAttribute("integrity", chunk.integrity);
          preload.setAttribute("crossorigin", "");
          document.head.appendChild(preload);
        });
    
        if (sheets.length > 0) {
          const loadedSheets = [];
          sheets.forEach(function (sheet) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.type = "text/css";
            link.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + sheet;
            link.media = "all";
            const sheetIntegrity = integrityByFile[sheet];
            if (sheetIntegrity != null) {
              link.setAttribute("integrity", sheetIntegrity);
              // SRI on a cross-origin stylesheet requires CORS mode; the CDN sends
              // access-control-allow-origin: *.
              link.setAttribute("crossorigin", "");
            }
            link.onload = function () {
              loadedSheets.push(sheet);
              if (loadedSheets.length === sheets.length) {
                loadBundle();
              }
            };
            link.onerror = loadBundle;
            document.head.insertBefore(link, document.getElementById("vite-preload"));
          });
        } else {
          loadBundle();
        }
      });
    </script>  </body>
