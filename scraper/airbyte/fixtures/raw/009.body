    <script nonce="NC2A75y5HZbP87PDWa7doihk6p1KPIDtJbkYIgQRr6g">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"5930fed9-c4f6-43c3-87be-3402c2c46489","title":"Senior Site Reliability Engineer","departmentName":"Engineering","departmentExternalName":"Engineering","locationName":"San Francisco","locationAddress":null,"workplaceType":"Hybrid","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><p style=\"min-height:1.5em\"></p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>The Role:</strong></h2><p style=\"min-height:1.5em\">You'll be one of two infrastructure and reliability specialists on the Data Replication team, a full-stack product team running millions of sync jobs a week that power thousands of data use cases across multiple regions and clouds. You'll build and maintain the infrastructure, set reliability standards, drive down incidents, and make it easier and safer for engineers to ship. </p><p style=\"min-height:1.5em\">Expect to spend roughly 30 to 50% of your time in backend application code, and the rest on infrastructure and reliability. When the fix belongs in the application, you'll ship it there yourself, and you'll build features alongside product engineers. We believe every abstraction leaks, so the best engineers work up and down the stack. You're equally comfortable in a Terraform file, a Kubernetes cluster, a service's codebase, and a postmortem doc. And with two of you in the room, we want someone who will challenge a design, not just implement it.</p><p style=\"min-height:1.5em\">We expect engineers here to actively use AI as a force multiplier: agentic tools to automate toil, augment incident response, and build smarter internal tooling. If you're not already doing this, you should be excited to start. We care as much about how you work as what you build. Trust, directness, and craftsmanship matter here.</p><h2></h2><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Do:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Own the infrastructure underpinning the Data Replication platform: Kubernetes clusters, CI/CD pipelines, secrets management, networking, and cloud resource configuration across AWS and GCP.</p></li><li><p style=\"min-height:1.5em\">Work across the stack: ship backend features and fixes in application code alongside product engineers, not just the infrastructure underneath them.</p></li><li><p style=\"min-height:1.5em\">Improve performance and efficiency at scale, from bursty job scheduling to right-sizing compute.</p></li><li><p style=\"min-height:1.5em\">Help us ship safely into customer-managed environments, where Airbyte runs in infrastructure we don't control.</p></li><li><p style=\"min-height:1.5em\">Evolve observability, alerting, and anomaly detection, with an eye toward LLM automation.</p></li><li><p style=\"min-height:1.5em\">Build AI-augmented release and internal tooling: canary deployments, progressive rollouts, automated release qualification, and rollback automation.</p></li><li><p style=\"min-height:1.5em\">Set the infrastructure bar for the team: build self-serve tooling, write runbooks, and coach engineers to own more of their stack.</p></li></ul><h2><strong>What You’ll Need:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">7+ years in infrastructure, platform engineering, SRE, or DevOps.</p></li><li><p style=\"min-height:1.5em\">Hands-on ownership of Kubernetes, Helm, and Terraform in production environments.</p></li><li><p style=\"min-height:1.5em\">Deep experience with observability stacks (Prometheus, Grafana, Datadog) and on-call operations.</p></li><li><p style=\"min-height:1.5em\">Experience with CI/CD pipeline ownership and developer tooling.</p></li><li><p style=\"min-height:1.5em\">Experience shipping changes to backend services in [language], not only infrastructure code, and the appetite to do more of it.</p></li><li><p style=\"min-height:1.5em\">Strong design judgment, and the confidence to challenge infrastructure decisions with data.</p></li><li><p style=\"min-height:1.5em\">Fluency with AI tools: LLMs and agentic frameworks to automate, debug faster, and reduce toil.</p></li><li><p style=\"min-height:1.5em\">A startup-ready mindset: comfortable with ambiguity, moving fast, and owning problems end to end.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Nice To Have:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Data pipelines, replication systems, or ETL/ELT platforms.</p></li><li><p style=\"min-height:1.5em\">Control plane / data plane architectures or internal developer platforms.</p></li><li><p style=\"min-height:1.5em\">Shipping software customers run in their own environments (Helm charts, upgrade paths, varied configurations).</p></li><li><p style=\"min-height:1.5em\">Experience with Airbyte, CDKs, or connector-based architectures.</p></li></ul><h2><strong>Location:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Onsite 4 days/week in San Francisco, CA</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">• Flexible PTO with a culture that encourages at least 25 days off annually<br /> • 16 weeks fully paid parental leave for all parents<br /> • Comprehensive medical, dental, and vision coverage for employees and dependents<br /> • 401(k) retirement plan<br /> • Professional development budget, conference sponsorship, and book reimbursement<br /> • Commuter benefits and monthly internet reimbursement</p><p style=\"min-height:1.5em\"> •  Breakfast and lunch in our San Francisco office<br /> • A collaborative, in-person culture focused on learning, growth, and impact</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is an equal opportunity employer that does not discriminate on the basis of actual or perceived race, creed, color, religion, national origin, ancestry, age, physical or mental disability, pregnancy, genetic information, sex, sexual orientation, gender identity or expression, marital status, familial status, domestic violence victim status, veteran or military status, or any other legally recognized protected basis under federal, state or local laws. Pursuant to the San Francisco Fair Chance Ordinance, we will consider for employment qualified applicants with arrest and conviction records.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is committed to providing reasonable accommodations for qualified individuals with disabilities in our job application procedures. Please let us know if you need assistance or accommodations due to a disability.</p>","isListed":true,"isConfidential":false,"teamNames":["Engineering"],"secondaryLocationNames":[],"compensationTierSummary":"$196K – $235K • Offers Equity","compensationTiers":[{"id":"70b82246-8e15-4f7f-aa51-93aa380cbbea","title":null,"tierSummary":"$196K – $235K • Offers Equity","__typename":"JobPostingCompensationTiers"}],"applicationDeadline":null,"compensationTierGuideUrl":null,"scrapeableCompensationSalarySummary":"$196K - $235K","compensationPhilosophyHtml":"<p style=\"min-height:1.5em\">The actual compensation package within the stated range will be based on a combination of factors such as an individual's skills, experience level, location, and other relevant job-related considerations.</p>","applicationLimitCalloutHtml":null,"shouldAskForTextingConsent":true,"shouldAskForWhatsAppConsent":false,"candidateTextingPrivacyPolicyUrl":"https://airbyte.com/company/privacy-policy","candidateTextingTermsAndConditionsUrl":null,"legalEntityNameForTextingConsent":"Airbyte, Inc","automatedProcessingLegalNotice":null,"__typename":"JobPostingDetails"},"jobBoard":null,"routerPrefix":"/","recaptchaPublicSiteKey":"6LeFb_YUAAAAALUD5h-BiQEp8JaFChe0e0A6r49Y","recaptchaUniversalPublicSiteKey":"6LezdY0tAAAAAEnollNLCAI0z1VDGwM7AzGrU4XZ"};
      // A Vite manifest key: the entry's HTML filename relative to the build root.
      // Single-entry apps leave entryHtml unset.
      const ENTRY_KEY = "index.html";
      fetch("https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/.vite/manifest.json").then(function (res) { return res.json() }).then(function (manifest) {
        const entryData = manifest[ENTRY_KEY];
        if (entryData == null) {
          throw new Error("Vite manifest is missing entry: " + ENTRY_KEY);
        }
    
        // Walk the entry's static imports transitively. Both the CSS and the JS a
        // page needs can sit on shared chunks rather than on the entry record, and
        // the manifest lists only each chunk's direct imports -- so reading the
        // entry alone silently drops stylesheets and preloads. Depth-first
        // post-order puts a dependency's CSS ahead of its importer's, which is the
        // cascade order Vite uses in the HTML it generates for the same entry.
        const chunks = [];
        const visited = {};
        function collectChunks(key) {
          if (visited[key] === true) {
            return;
          }
          visited[key] = true;
          const chunk = manifest[key];
          if (chunk == null) {
            return;
          }
          (chunk.imports ?? []).forEach(collectChunks);
          chunks.push(chunk);
        }
        collectChunks(ENTRY_KEY);
    
        // css[] holds output paths, not digests, but every manifest record carries
        // an integrity for its own file -- so a stylesheet Vite emitted as its own
        // record can be matched by path. The entry's CSS has no record and loads
        // unhashed.
        const integrityByFile = {};
        Object.keys(manifest).forEach(function (key) {
          const record = manifest[key];
          if (record != null && record.file != null && record.integrity != null) {
            integrityByFile[record.file] = record.integrity;
          }
        });
    
        const sheets = [];
        const seenSheets = {};
        chunks.forEach(function (chunk) {
          (chunk.css ?? []).forEach(function (sheet) {
            if (seenSheets[sheet] === true) {
              return;
            }
            seenSheets[sheet] = true;
            sheets.push(sheet);
          });
        });
    
        let bundleLoaded = false;
        function loadBundle() {
          if (bundleLoaded === true) {
            return;
          }
    
          const el = document.createElement("script");
          el.setAttribute("type", "module");
          el.setAttribute("crossorigin", "");
          el.setAttribute("integrity", entryData.integrity);
          el.setAttribute("src", "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + entryData.file);
          document.head.appendChild(el);
          bundleLoaded = true;
        }
    
        chunks.forEach(function (chunk) {
          const preload = document.createElement("link");
          preload.rel = "modulepreload";
          preload.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + chunk.file;
          // Carry the SRI hash on the preload too: Chrome/Firefox reuse the
          // preloaded bytes for the integrity-bearing script tag, so an integrity-less
          // preload silently bypasses the SRI check. Without it here, SRI is never
          // enforced on the code-split chunks (the bulk of the app), in any browser.
          preload.setAttribute("integrity", chunk.integrity);
          preload.setAttribute("crossorigin", "");
          document.head.appendChild(preload);
        });
    
        if (sheets.length > 0) {
          const loadedSheets = [];
          sheets.forEach(function (sheet) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.type = "text/css";
            link.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + sheet;
            link.media = "all";
            const sheetIntegrity = integrityByFile[sheet];
            if (sheetIntegrity != null) {
              link.setAttribute("integrity", sheetIntegrity);
              // SRI on a cross-origin stylesheet requires CORS mode; the CDN sends
              // access-control-allow-origin: *.
              link.setAttribute("crossorigin", "");
            }
            link.onload = function () {
              loadedSheets.push(sheet);
              if (loadedSheets.length === sheets.length) {
                loadBundle();
              }
            };
            link.onerror = loadBundle;
            document.head.insertBefore(link, document.getElementById("vite-preload"));
          });
        } else {
          loadBundle();
        }
      });
    </script>  </body>
