    <script nonce="Wdh2yAsggGp4EgiPkxHrjyexPVp5ysRF9WiSHpOzqBc">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"cbf66746-9e2a-4b23-a208-a6d78eb5ec63","title":"Senior Solutions Architect","departmentName":"Sales","departmentExternalName":"Sales","locationName":"New York","locationAddress":null,"workplaceType":"Remote","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2>The Role</h2><p style=\"min-height:1.5em\">As an Airbyte Senior Solutions Architect, you will serve as a trusted post-sales technical partner to enterprise customers, helping them successfully onboard, implement, adopt, and expand their use of Airbyte.</p><p style=\"min-height:1.5em\">You will own the technical customer relationship after the sale, working closely with customer engineering, platform, infrastructure, and data teams to understand their environment, guide implementation, troubleshoot issues, and ensure they are getting long-term value from Airbyte.</p><p style=\"min-height:1.5em\">This is also a highly hands-on technical role. A major part of the job involves working directly in customer Kubernetes environments to deploy, configure, troubleshoot, and optimize Airbyte in production. You should be comfortable getting into the weeds with customers across workloads, pods, networking, storage, resource management, APIs, databases, CDC, and data movement issues.</p><p style=\"min-height:1.5em\">You will act as the bridge between customers and Airbyte’s Support, Product, Engineering, and Sales teams, serving as the internal source of truth for customer technical needs while helping drive adoption, retention, and expansion.</p><p style=\"min-height:1.5em\">Joining Airbyte at this stage means working at the intersection of data infrastructure, cloud platforms, and AI while helping shape how enterprise customers successfully deploy and scale our products.</p><h2><br />What You’ll Do</h2><h3>Own Post-Sales Technical Success</h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Serve as the primary technical partner for enterprise customers after the sale, owning the technical relationship throughout onboarding, implementation, adoption, and expansion.</p></li><li><p style=\"min-height:1.5em\">Build trusted relationships with customer engineering, infrastructure, platform, and data teams.</p></li><li><p style=\"min-height:1.5em\">Develop a deep understanding of each customer’s architecture, use cases, technical requirements, and long-term goals.</p></li><li><p style=\"min-height:1.5em\">Guide customers through implementation and adoption while proactively identifying risks, blockers, and opportunities to improve their deployment.</p></li><li><p style=\"min-height:1.5em\">Partner with customers to define technical success and ensure they are realizing measurable value from Airbyte.</p></li><li><p style=\"min-height:1.5em\">Coordinate with Airbyte Support, Product, and Engineering to resolve complex customer issues and drive successful outcomes.</p></li><li><p style=\"min-height:1.5em\">Act as the internal source of truth for customer technical requirements, infrastructure constraints, product feedback, and feature needs.</p></li><li><p style=\"min-height:1.5em\">Identify opportunities for broader adoption and expansion in partnership with Sales and Customer Success.</p></li><li><p style=\"min-height:1.5em\">Build long-term technical relationships that improve customer satisfaction, retention, and growth.</p></li></ul><h3>Hands-On Kubernetes &amp; Technical Implementation</h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Work directly in customer Kubernetes environments to deploy, configure, troubleshoot, and optimize Airbyte in production.</p></li><li><p style=\"min-height:1.5em\">Troubleshoot Kubernetes workloads, pods, deployments, networking, storage, resource allocation, scheduling, logs, and performance issues.</p></li><li><p style=\"min-height:1.5em\">Diagnose complex production issues across Kubernetes clusters and work alongside customer engineering teams to identify root causes and implement solutions.</p></li><li><p style=\"min-height:1.5em\">Help customers apply Kubernetes best practices related to reliability, scalability, observability, and resource management.</p></li><li><p style=\"min-height:1.5em\">Lead technical implementation projects and ensure Airbyte is configured successfully within customer infrastructure, security, and operational requirements.</p></li><li><p style=\"min-height:1.5em\">Troubleshoot complex data movement issues involving SQL databases, CDC, database replication, and data synchronization.</p></li><li><p style=\"min-height:1.5em\">Work with REST APIs, HTTP, authentication, OAuth, API keys, JWT, webhooks, and JSON to diagnose and resolve integration issues.</p></li><li><p style=\"min-height:1.5em\">Advise customers on integrating LLM-based tooling and AI workflows into their existing data infrastructure alongside Airbyte connectors.</p></li></ul><h3>Cross-Functional Collaboration</h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Partner closely with Product and Engineering to surface recurring customer challenges and influence the roadmap.</p></li><li><p style=\"min-height:1.5em\">Collaborate with Support to resolve complex technical issues and improve escalation paths.</p></li><li><p style=\"min-height:1.5em\">Work with Sales to identify technical opportunities for expansion within existing customers.</p></li><li><p style=\"min-height:1.5em\">Help improve onboarding playbooks, implementation guides, troubleshooting documentation, and customer best practices.</p></li><li><p style=\"min-height:1.5em\">Share customer feedback and technical insights internally to improve the overall enterprise customer experience.</p></li></ul><h3>Advocacy and Evangelism</h3><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Demonstrate Airbyte architecture, implementation patterns, and best practices to customers and at industry events.</p></li><li><p style=\"min-height:1.5em\">Serve as a technical ambassador for Airbyte with customers and the broader developer and data community.</p></li><li><p style=\"min-height:1.5em\">Evangelize best practices for building reliable, scalable, and AI-ready data infrastructure.</p></li><li><p style=\"min-height:1.5em\">Create technical content such as blog posts, demos, implementation guides, and conference talks.</p></li></ul><h2>What You’ll Need</h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">6+ years of experience in a customer-facing post-sales technical role such as Solutions Architect, Technical Account Manager, Resident Solutions Architect, Professional Services Engineer, Customer Engineer, or technical consultant.</p></li><li><p style=\"min-height:1.5em\">Experience owning long-term technical relationships with enterprise customers across onboarding, implementation, adoption, troubleshooting, and expansion.</p></li><li><p style=\"min-height:1.5em\">Strong, hands-on Kubernetes experience in production environments. You should be comfortable independently troubleshooting workloads, pods, deployments, networking, storage, resource management, logs, and cluster-level issues.</p></li><li><p style=\"min-height:1.5em\">Experience deploying, operating, or troubleshooting applications running on Kubernetes, not just designing or advising on Kubernetes architecture.</p></li><li><p style=\"min-height:1.5em\">Strong understanding of cloud infrastructure and production systems.</p></li><li><p style=\"min-height:1.5em\">Deep understanding of database technologies, including SQL, CDC, database replication, and data synchronization.</p></li><li><p style=\"min-height:1.5em\">Strong knowledge of REST APIs, HTTP, authentication, OAuth, API keys, JWT, webhooks, and JSON.</p></li><li><p style=\"min-height:1.5em\">2+ years of experience in a startup environment, ideally within modern data infrastructure, cloud infrastructure, databases, ELT/ETL, developer tools, or data warehouses.</p></li><li><p style=\"min-height:1.5em\">Experience supporting technically complex products that directly impact customer operations or business productivity.</p></li><li><p style=\"min-height:1.5em\">Strong customer orientation with a track record of driving successful onboarding, implementation, adoption, and ongoing technical outcomes.</p></li><li><p style=\"min-height:1.5em\">Strong interpersonal, communication, and presentation skills.</p></li><li><p style=\"min-height:1.5em\">Ability to build credibility with engineers while also communicating effectively with technical leadership and business stakeholders.</p></li></ul><h2>Nice to Have</h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Experience with Terraform, Helm, cloud networking, or infrastructure-as-code.</p></li><li><p style=\"min-height:1.5em\">Experience with AWS, GCP, or Azure.</p></li><li><p style=\"min-height:1.5em\">Experience with observability, monitoring, and debugging production infrastructure.</p></li><li><p style=\"min-height:1.5em\">Hands-on experience with one or more AI or LLM frameworks.</p></li><li><p style=\"min-height:1.5em\">Exposure to AI agent frameworks, MCP, or prompt engineering.</p></li><li><p style=\"min-height:1.5em\">Experience with modern data infrastructure, ELT tools, data warehouses, or distributed systems.</p></li></ul><h2>Location</h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Remote from New York City / East Coast timezone.</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">• Flexible PTO with a culture that encourages at least 25 days off annually<br /> • 16 weeks fully paid parental leave for all parents<br /> • Comprehensive medical, dental, and vision coverage for employees and dependents<br /> • 401(k) retirement plan<br /> • Professional development budget, conference sponsorship, and book reimbursement<br /> • Commuter benefits and monthly internet reimbursement</p><p style=\"min-height:1.5em\"> •  Breakfast and lunch in our San Francisco office<br /> • A collaborative, in-person culture focused on learning, growth, and impact</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is an equal opportunity employer that does not discriminate on the basis of actual or perceived race, creed, color, religion, national origin, ancestry, age, physical or mental disability, pregnancy, genetic information, sex, sexual orientation, gender identity or expression, marital status, familial status, domestic violence victim status, veteran or military status, or any other legally recognized protected basis under federal, state or local laws. Pursuant to the San Francisco Fair Chance Ordinance, we will consider for employment qualified applicants with arrest and conviction records.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Airbyte is committed to providing reasonable accommodations for qualified individuals with disabilities in our job application procedures. Please let us know if you need assistance or accommodations due to a disability.</p>","isListed":true,"isConfidential":false,"teamNames":["Sales","Solutions Architecture "],"secondaryLocationNames":[],"compensationTierSummary":"$159,375 – $255,000 • Offers Equity • Offers Commission • Multiple Ranges","compensationTiers":[{"id":"a834280f-65d6-4878-a263-37fac54c3990","title":"Tier 1 - New York City","tierSummary":"OTE $213,000 – $255,000 • Offers Equity • Offers Commission","__typename":"JobPostingComp