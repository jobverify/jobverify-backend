    <script nonce="1YQ-1mYRQXnQZrGwM4XwLe-K1KNJQfPMtBZFY8bclgs">
      window.__appData = {"ddRumApplicationId":"80e0bf43-e772-45ac-858b-1e6dc0f1f415","ddRumClientToken":"pub1a87c7036063ee7d4b7914b397e6324e","environment":"production","maintenanceMode":false,"schedulingMaintenanceMode":false,"organization":{"organizationId":"c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2","name":"Airbyte","publicWebsite":"https://airbyte.com/","customJobsPageUrl":null,"hostedJobsPageSlug":"airbyte","allowJobPostIndexing":false,"isDemoOrg":false,"theme":{"colors":{"version":"1","colorPrimary600":"#6059b2","colorPrimary900":"#1d1b3e"},"showJobFilters":true,"showLocationAddress":false,"showTeams":false,"showAutofillApplicationsBox":true,"logoWordmarkImageUrl":"https://app.ashbyhq.com/api/images/org-theme-wordmark/c410bf6e-88b0-4ac8-91a5-e5d8a297c6d2/70d79e97-c56d-4a72-b6ec-0861471b0fbd/ff36ec79-a784-4a7f-9ae0-57dabc217726.png","logoSquareImageUrl":null,"applicationSubmittedSuccessMessage":null,"jobBoardTopDescriptionHtml":null,"jobBoardBottomDescriptionHtml":null,"jobPostingBackUrl":null,"__typename":"Theme"},"appConfirmationTrackingPixelHtml":null,"recruitingPrivacyPolicyUrl":null,"activeFeatureFlags":["AiNotetakerCandidateConsentPolicies","ApplicationForReferrals","ApprovalNotesFromEmail","BookingLinkRescheduleLimits","CanonicalizeSchools","CoreMultipleBrands","CoreMultipleBrandsFeedFiltering","CoreMultipleBrandsLinkedInJobWrappingStreamingFix","DemoOrgBanners","EducationHistoryFormField","ExplicitAutomatedProcessingOptOutConfirmation","JobBoardCookieConsentControls","JobBoardEtagValidation","JobPostingApplicationDeadlines","JobPostingListV2","JobPostingWorkplaceTypeOverrideSecondaryLocationsToo","LinkedInIntegrationRequireCompanyId","LinkedInTOSUpdate","LocationExternalName","MigrateGoogleRecaptchaAutomatedLegal","RejectBase64EncodedResumesFrontEnd","RejectBase64EncodedResumesThrowErrorFrontEnd","RejectInvalidFileTypeOnUpload","RejectUrlsInCandidateName","SchedulingDirectBookingLogDirectBookingEventsJson","SchedulingGCalSendUpdatesForCancelEvents","SchedulingRescheduleAndCancellationReasonsNonUser","SchedulingUseLocaleInTimeFormatting","ShowCountsOnJobBoardFilterOptions","SocialSharingHtmlMetaSettings","UseGlobalQueryScopesOnGlobalApplicationQuestions","UseGoogleRecaptchaUniversalKey","UseJobPostingFiltersOnGlobalApplicationQuestions","UseJobPostingFiltersOnGlobalApplicationQuestionsUI","UseJobPostingFiltersOnSurveys","UseJobPostingFiltersOnSurveysUI","ValidateFileTypeOnUpload"],"timezone":"America/Los_Angeles","candidateScheduleCancellationReasonRequirementStatus":"Off","showCookieBanner":false,"__typename":"Organization"},"posting":{"id":"9b312680-5bcf-40b3-9cba-1023d2c9b895","title":"Senior Technical Account Manager","departmentName":"Sales","departmentExternalName":"Sales","locationName":"Canada","locationAddress":null,"workplaceType":"Remote","employmentType":"FullTime","descriptionHtml":"<p style=\"min-height:1.5em\">Airbyte is the data and action layer for AI agents. We give agents fast, accurate, authenticated access to business data across hundreds of sources, so they can discover the entities that matter, reason over real-time context, and take action in the systems they read from, not just observe them.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">We started as the open-source standard for data movement and proved the economics of data integration at scale: hundreds of connectors, thousands of companies, and, since 2020, have raised $181M from leading investors including Benchmark, Accel, Altimeter, Coatue, and Y Combinator. As our CEO Michel Tricot puts it, \"the last ten years were all about structured data. The future is all about context.\" We're now building that context infrastructure for production-grade agents on the same open foundation, as agents become the primary consumers of enterprise data.</p><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Our mission is unchanged: make data available and actionable to everyone, everywhere. That everyone now includes AI agents.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>The Role:</strong></h2><p style=\"min-height:1.5em\">As an Airbyte Senior Technical Account Manager, you will have a unique opportunity to elevate your career and make an immediate impact in the rapidly growing data infrastructure sector. In this role, you will play a pivotal part in helping customers implement and adopt our products while serving as their advocate within the company. This includes collaborating with Go-to-Market (GTM), Product, and Engineering teams to refine and enhance the onboarding, implementation, and growth experiences for enterprise customers. You will also work closely with cross-functional teams to support both sales and post-sales efforts, driving improved qualification, faster deal cycles, and higher levels of customer satisfaction and retention. Joining us at this stage means you’ll be on the ground floor of a rapidly expanding Series B startup, with significant opportunities for professional growth and advancement.</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Do:</strong></h2><p style=\"min-height:1.5em\">Technical Implementation</p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Lead and execute impactful customer technical projects, including the implementation and deployment of Airbyte solutions, while ensuring alignment with client requirements and industry best practices.</p></li><li><p style=\"min-height:1.5em\">Guide customers throughout their customer journey by leveraging your technical expertise and stepping in with hands-on support when needed.</p></li><li><p style=\"min-height:1.5em\">Deep Kubernetes expertise, including hands-on troubleshooting of workloads, pods, networking, storage, and resource management in production.</p></li><li><p style=\"min-height:1.5em\">Deep understanding of database technologies, including SQL, CDC (Change Data Capture), database replication, and data synchronization concepts, with the ability to troubleshoot complex data movement issues.</p></li><li><p style=\"min-height:1.5em\">Strong knowledge of REST APIs, including HTTP methods, authentication (OAuth, API keys, JWT), webhooks, and JSON, with the ability to troubleshoot complex integration issues.</p></li><li><p style=\"min-height:1.5em\">Advise customers on integrating LLM-based tooling into their existing data infrastructure alongside Airbyte connectors.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Client Engagement</p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Work directly with clients’ technical teams to understand their needs and tailor solutions accordingly.</p></li><li><p style=\"min-height:1.5em\">Managing technical success by collaborating with Airbyte’s technical support, Product, and Engineering teams to address issues and deliver new features.</p></li><li><p style=\"min-height:1.5em\">Help clients evaluate and adopt AI agent frameworks to build autonomous data agents that leverage Airbyte as a data source.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Cross-Department Collaboration</p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Collaborate with Sales to identify and drive potential growth opportunities with customers.</p></li><li><p style=\"min-height:1.5em\">Act as the internal source of truth for customer technical requirements, expectations, and needed functionalities.</p></li><li><p style=\"min-height:1.5em\">Partner with Product and Engineering teams to surface customer needs, influencing the roadmap.</p></li></ul><p style=\"min-height:1.5em\"></p><p style=\"min-height:1.5em\">Advocacy and Evangelism </p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Demonstrate the use and best practices of Airbyte’s offering to clients and at industry events.</p></li><li><p style=\"min-height:1.5em\">Serve as a brand ambassador promoting the organization’s mission and fostering relationships with key stakeholders.</p></li><li><p style=\"min-height:1.5em\">Evangelize best practices for building AI-ready data stacks.</p></li><li><p style=\"min-height:1.5em\">Create and deliver technical content (blog posts, demos, conference talks) showcasing how Airbyte enables modern AI architectures.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>What You’ll Need:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">6+ years of experience in a customer-facing technical role, such as Technical Account Manager, resident solutions architect, professional services engineer, or consulting role.</p></li><li><p style=\"min-height:1.5em\">Deep, hands-on Kubernetes experience in production environments. You should be comfortable directly troubleshooting workloads, pods, networking, storage, resource allocation, and deployment issues rather than solely advising customers at a high level.</p></li><li><p style=\"min-height:1.5em\">2+ years of experience in a startup environment, ideally in modern data infrastructure, including cloud applications, databases, ELT tools, data warehouses or related fields (startup implementation experience is a bonus).</p></li><li><p style=\"min-height:1.5em\">Hands-on experience with one or more AI frameworks.</p></li><li><p style=\"min-height:1.5em\">Exposure to AI agent frameworks and prompt engineering best practices is a strong plus.</p></li><li><p style=\"min-height:1.5em\">Proven track record of supporting products that directly impact business productivity.</p></li><li><p style=\"min-height:1.5em\">Exceptional customer orientation with a focus on delivering seamless onboarding and ongoing technical success.</p></li><li><p style=\"min-height:1.5em\">Strong interpersonal and presentation skills.</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><h2><strong>Location:</strong></h2><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Remote from Toronto, supporting East Coast Timezone</p></li></ul><p style=\"min-height:1.5em\"></p><h2><strong>Why You'll Love Working at Airbyte:</strong></h2><p style=\"min-height:1.5em\">At Airbyte, we believe great work happens when people feel supported, trusted, and empowered to grow. Our market-leading Total Rewards package is designed to help you thrive professionally and personally. Our benefits and perks include:</p><ul style=\"min-height:1.5em\"><li><p style=\"min-height:1.5em\">Flexible PTO with a culture that encourages at least 25 days off annually, and public holidays in line with provincial employment standards</p></li><li><p style=\"min-height:1.5em\">Comprehensive health coverage – extended health benefits on top of provincial public healthcare</p></li><li><p style=\"min-height:1.5em\">Virtual healthcare – access to doctors and other care providers online, so you can get care without waiting</p></li><li><p style=\"min-height:1.5em\">Retirement savings – a group retirement savings plan to help you build for the future</p></li><li><p style=\"min-height:1.5em\">Statutory protections – Canada/Québec Pension Plan, Employment Insurance and workers' compensation coverage</p></li><li><p style=\"min-height:1.5em\">Professional development budget, conference sponsorship, and book reimbursement</p></li></ul><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><p style=\"min-height:1.5em\">If you find this role exciting, we encourage you to apply even if you think you don’t meet all of the requirements!</p><div style=\"min-height:1.2em;margin-top:0px;margin-bottom:0px\"> </div><p style=\"min-height:1.5em\">We are not accepting agency submissions or recruiting firm support for this role. Unsolicited resumes will not be considered.</p>","isListed":true,"isConfidential":false,"teamNames":["Sales"],"secondaryLocationNames":[],"compensationTierSummary":"CA$185K – CA$222K • Offers Equity • Offers Commission","compensationTiers":[{"id":"8844e385-340f-40b4-92d1-c5ca66b06b84","title":null,"tierSummary":"OTE CA$185K – CA$222K • Offers Equity • Offers Commission","__typename":"JobPostingCompensationTiers"}],"applicationDeadline":null,"compensationTierGuideUrl":null,"scrapeableCompensationSalarySummary":"CA$185K - CA$222K","compensationPhilosophyHtml":"<p style=\"min-height:1.5em\">The actual compensation package within the stated range will be based on a combination of factors such as an individual's skills, experience level, location, and other relevant job-related considerations.</p>","applicationLimitCalloutHtml":null,"shouldAskForTextingConsent":true,"shouldAskForWhatsAppConsent":false,"candidateTextingPrivacyPolicyUrl":"https://airbyte.com/company/privacy-policy","candidateTextingTermsAndConditionsUrl":null,"legalEntityNameForTextingConsent":"Airbyte, Inc","automatedProcessingLegalNotice":null,"__typename":"JobPostingDetails"},"jobBoard":null,"routerPrefix":"/","recaptchaPublicSiteKey":"6LeFb_YUAAAAALUD5h-BiQEp8JaFChe0e0A6r49Y","recaptchaUniversalPublicSiteKey":"6LezdY0tAAAAAEnollNLCAI0z1VDGwM7AzGrU4XZ"};
      // A Vite manifest key: the entry's HTML filename relative to the build root.
      // Single-entry apps leave entryHtml unset.
      const ENTRY_KEY = "index.html";
      fetch("https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/.vite/manifest.json").then(function (res) { return res.json() }).then(function (manifest) {
        const entryData = manifest[ENTRY_KEY];
        if (entryData == null) {
          throw new Error("Vite manifest is missing entry: " + ENTRY_KEY);
        }
    
        // Walk the entry's static imports transitively. Both the CSS and the JS a
        // page needs can sit on shared chunks rather than on the entry record, and
        // the manifest lists only each chunk's direct imports -- so reading the
        // entry alone silently drops stylesheets and preloads. Depth-first
        // post-order puts a dependency's CSS ahead of its importer's, which is the
        // cascade order Vite uses in the HTML it generates for the same entry.
        const chunks = [];
        const visited = {};
        function collectChunks(key) {
          if (visited[key] === true) {
            return;
          }
          visited[key] = true;
          const chunk = manifest[key];
          if (chunk == null) {
            return;
          }
          (chunk.imports ?? []).forEach(collectChunks);
          chunks.push(chunk);
        }
        collectChunks(ENTRY_KEY);
    
        // css[] holds output paths, not digests, but every manifest record carries
        // an integrity for its own file -- so a stylesheet Vite emitted as its own
        // record can be matched by path. The entry's CSS has no record and loads
        // unhashed.
        const integrityByFile = {};
        Object.keys(manifest).forEach(function (key) {
          const record = manifest[key];
          if (record != null && record.file != null && record.integrity != null) {
            integrityByFile[record.file] = record.integrity;
          }
        });
    
        const sheets = [];
        const seenSheets = {};
        chunks.forEach(function (chunk) {
          (chunk.css ?? []).forEach(function (sheet) {
            if (seenSheets[sheet] === true) {
              return;
            }
            seenSheets[sheet] = true;
            sheets.push(sheet);
          });
        });
    
        let bundleLoaded = false;
        function loadBundle() {
          if (bundleLoaded === true) {
            return;
          }
    
          const el = document.createElement("script");
          el.setAttribute("type", "module");
          el.setAttribute("crossorigin", "");
          el.setAttribute("integrity", entryData.integrity);
          el.setAttribute("src", "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + entryData.file);
          document.head.appendChild(el);
          bundleLoaded = true;
        }
    
        chunks.forEach(function (chunk) {
          const preload = document.createElement("link");
          preload.rel = "modulepreload";
          preload.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + chunk.file;
          // Carry the SRI hash on the preload too: Chrome/Firefox reuse the
          // preloaded bytes for the integrity-bearing script tag, so an integrity-less
          // preload silently bypasses the SRI check. Without it here, SRI is never
          // enforced on the code-split chunks (the bulk of the app), in any browser.
          preload.setAttribute("integrity", chunk.integrity);
          preload.setAttribute("crossorigin", "");
          document.head.appendChild(preload);
        });
    
        if (sheets.length > 0) {
          const loadedSheets = [];
          sheets.forEach(function (sheet) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.type = "text/css";
            link.href = "https://cdn.ashbyprd.com/frontend_non_user/860ceee3368252383aede38f0562dd8d34f6ca27/" + sheet;
            link.media = "all";
            const sheetIntegrity = integrityByFile[sheet];
            if (sheetIntegrity != null) {
              link.setAttribute("integrity", sheetIntegrity);
              // SRI on a cross-origin stylesheet requires CORS mode; the CDN sends
              // access-control-allow-origin: *.
              link.setAttribute("crossorigin", "");
            }
            link.onload = function () {
              loadedSheets.push(sheet);
              if (loadedSheets.length === sheets.length) {
                loadBundle();
              }
            };
            link.onerror = loadBundle;
            document.head.insertBefore(link, document.getElementById("vite-preload"));
          });
        } else {
          loadBundle();
        }
      });
    </script>  </body>
