script\">\nvar googleJobPosting = false;\n</script>\n\n<!--  TODO NEHA : to check autowire in jsp and get this value from property file -->\n\n\n<script type=\"text/javascript\">\n    $conv = jQuery;\n    $conv(document).ready(function () {\n        $('.wrapper').mask(\"\");\n        $(\".copy-year\").html(new Date().getFullYear().toString());\n        $(\"#redirectHash\").val(window.location.hash.slice(1, window.location.hash.length));\n\n    });\n\n    function initialieFB() {\n        FB.init({appId: '1153447089645129', status: true, cookie: true, xfbml: true, oauth: true});\n        window.fbAsyncInit = function () {\n            function initilizeFacebook(response) {\n                if (response.authResponse) {\n                    FB.api('/me', function (info) {\n                    });\n                } else {\n                }\n            }\n\n            FB.getLoginStatus(initilizeFacebook);\n            FB.Event.subscribe('auth.statusChange', initilizeFacebook);\n        };\n    }\n\n    $.getScript('//connect.facebook.net/en_US/all.js').done(function () {\n        initialieFB();\n    });\n</script>\n<script>\n    function stopRKey(evt) {\n        var evt = (evt) ? evt : ((event) ? event : null);\n        var node = (evt.target) ? evt.target : ((evt.srcElement) ? evt.srcElement : null);\n        if ((evt.keyCode == 13) && (node.type == \"text\")) {\n            return false;\n        }\n    }\n\n    var getRefValue = function () {\n        var refValue = Metronic.getURLParameter('ref');\n        if (refValue) {\n            return refValue;\n        }\n        return \"\";\n    };\n    var getHashValue = function () {\n        var hashLoc = window.location.hash;\n        if (hashLoc) {\n            if (hashLoc.indexOf('/') > -1) {\n                return hashLoc.substring(1, hashLoc.indexOf('/'));\n            } else {\n                return hashLoc.substring(1);\n            }\n        }\n        return \"\";\n    };\n    document.onkeypress = stopRKey;\n\n    function headerLoadSuccess(){\n        \n    }\n\n    function footerLoadSuccess(){\n        \n    }\n</script>\n\n    <link rel=\"stylesheet\" type=\"text/css\"\n          href=\"/candidate/candresource/css/company/axis.css\">\n\n\n<style>\n    body {\n        background-image: url(/candidate/getcandidatelogo/backImg/background-bg.png/AXISSL);\n        background-color: #FFFFFF\n    }\n\n    .navbar-default {\n        background-color: #97144d;\n    }\n\n    .btn-1-color-theme {\n        background-color: #97144d !important;\n        border-color: #97144d !important;\n\n    }\n\n    .btn-1-color-theme:active:hover, .btn-1-color-theme:active, .btn-1-color-theme:hover {\n        background-color: #97144d !important;\n        border-color: #97144d !important;\n    }\n\n    .btn-2-color-theme {\n        border-color: #97144d !important;\n        color: #97144d !important;\n    }\n\n    .btn-2-color-theme:active:hover, .btn-2-color-theme:active, .btn-2-color-theme:hover {\n        background-color: #97144d !important;\n        color: #FFF !important;\n    }\n\n    .btn-default-color-theme {\n        background-color: #FFF !important;\n        color: gray !important;\n        border-color: grey !important;;\n    }\n\n    .dpdp-info-icon {\n        color: #97144d !important;\n    }\n\n    .btn-default-color-theme:active:hover, .btn-default-color-theme:active, .btn-default-color-theme:hover {\n        background-color: grey !important;\n        color: #FFF !important;\n        border-color: grey !important;;\n    }\n\n    .poweredBy {\n        color: #FFFFFF !important;\n    }\n\n    #filter-btn-mob:hover, #filter-btn-mob:active {\n        background-color: #97144d;\n    }\n\n    .dpdp-consent-card.dpdp-state-default .dpdp-card-icon,\n    .dpdp-consent-card.dpdp-state-accepted .dpdp-card-icon,\n    .dpdp-consent-card.dpdp-state-declined .dpdp-card-icon {\n        background: #97144d !important;\n    }\n\n    /* PRD-8377: careers-page static colour-contrast fixes (WCAG 1.4.3). Page-scoped â\n       this <style> loads only on the candidate career-site routes. Blue #005FCC and\n       grey #6E6E6E chosen to clear AA 4.5:1 on the footer/white/amber backgrounds\n       (product's #0076FB / #747474 were just under). Tappable text keeps its underline. */\n    #footer-panel,\n    #footer-panel .text-center,\n    #footer-panel .text-muted,\n    #footer-panel .copy-year {\n        color: #6E6E6E !important;   /* copyright + year + the bare \"|\" separators: #6E6E6E on #f7f7f7 = 4.76:1 (was #777 @4.48) */\n    }\n    #footer-panel a.text-muted {\n        color: #005FCC !important;   /* footer links: 5.59:1 */\n        text-decoration: underline !important;\n    }\n    a.js-view-all-jobs {\n        color: #005FCC !important;   /* \"click here\" inside the amber job-unavailable alert: 4.97:1 */\n        text-decoration: underline !important;\n    }\n    .consent-terms {\n        color: #2A2A2A !important;   /* consent body text: 14.4:1 on white */\n    }\n    .consent-terms a {\n        color: #005FCC !important;   /* consent terms/privacy links */\n        text-decoration: underline !important;\n    }\n    #reject.btn-default-color-theme {\n        background-color: #FFFFFF !important;  /* \"I Don't Agree\": #2A2A2A on #FFF = 14.4:1, #EFEFEF outline */\n        color: #2A2A2A !important;\n        border-color: #EFEFEF !important;\n    }\n    /* Location/Experience multiselect placeholder text (was low-contrast grey) */\n    .multiselect-selected-text {\n        color: #6E6E6E !important;   /* 5.1:1 on white */\n    }\n    /* Outlined secondary CTAs (e.g. \"Click here\" js-ctp-apply) used the brand colour\n       as TEXT on white, which fails for light brand colours. Keep the brand-coloured\n       border, but make the text dark #2A2A2A (14:1). Filled/hover state keeps the\n       brand background with the luminance-picked text from the E1 script below. */\n    .btn-2-color-theme {\n        color: #2A2A2A !important;\n    }\n    /* PRD-8377 (QA follow-up): \"Browse\" controls on the apply form (#apply) had no\n       explicit text colour in the shared theme, inheriting a light grey that failed AA.\n       - Photo-upload Browse (the element Lighthouse flagged, CR-7): <button class=\"btn\">\n         inside .photo-upload-btn, bg #CACACA (ripplehire-theme.css:2906), no colour â\n         #2A2A2A on #CACACA = ~8.6:1.\n       - Resume fileinput Browse (.btn-file .fileinput-new) on white â 14.4:1. */\n    .photo-upload-btn .btn,\n    .btn-upload-photo,\n    #btn-upload-photo,\n    .btn-file .fileinput-new,\n    .input-group-addon.btn-file {\n        color: #2A2A2A !important;\n    }\n</style>\n<span id=\"rh-brand-colour\" data-colour=\"#97144d\" style=\"display:none;\"></span>\n<script>\n(function () {\n  /* PRD-8377: auto-select black/white TEXT for buttons filled with the tenant brand\n     colour (btn-1-color-theme; btn-2-color-theme on hover) so text contrast passes for\n     every tenant WITHOUT changing the brand colour. WCAG relative-luminance threshold\n     0.179 picks whichever of black/white has the higher contrast against the brand bg.\n     Reads the c:out-escaped colour and validates it as hex (no XSS, no innerHTML). */\n  var el = document.getElementById('rh-brand-colour');\n  var brand = el ? el.getAttribute('data-colour') : '';\n  function safeText(hex) {\n    if (!hex) return '';\n    hex = hex.trim().replace(/^#/, '');\n    if (hex.length === 3) hex = hex.replace(/(.)/g, '$1$1');\n    if (!/^[0-9a-fA-F]{6}$/.test(hex)) return '';\n    var ch = [0, 2, 4].map(function (i) {\n      var c = parseInt(hex.substr(i, 2), 16) / 255;\n      return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);\n    });\n    var lum = 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];\n    return lum > 0.179 ? '#000000' : '#FFFFFF';\n  }\n  var txt = safeText(brand);\n  if (txt) {\n    var css = '.btn-1-color-theme,'\n      + '.btn-2-color-theme:active:hover,.btn-2-color-theme:active,.btn-2-color-theme:hover'\n      + '{color:' + txt + ' !important;}';\n    var st = document.createElement('style');\n    st.appendChild(document.createTextNode(css));\n    document.body.appendChild(st);\n  }\n})();\n</script>\n<script>\n(function () {\n  /* PRD-8377: the company-configured privacy/consent content renders a stack of <h4>\n     section headings (\"Privacy Notice\", \"Data Collection\", â¦) that skip from the page\n     <h2>, failing heading order. Re-level any <h4>/<h5>/<h6> inside the privacy/consent\n     content up by one (h4->h3, h5->h4, h6->h5) while preserving the visual size via a\n     Bootstrap .hN class, so the outline is sequential. Runs on load and watches for the\n     consent step, which renders after navigation. No text is changed â only heading tags. */\n  function relevel() {\n    var sel = '.terms-content h4:not([data-rh8377]),.terms-content h5:not([data-rh8377]),.terms-content h6:not([data-rh8377]),'\n            + '.dpdp-modal-body h4:not([data-rh8377]),.dpdp-modal-body h5:not([data-rh8377]),.dpdp-modal-body h6:not([data-rh8377])';\n    var hs = document.querySelectorAll(sel);\n    for (var i = 0; i < hs.length; i++) {\n      var h = hs[i];\n      var lvl = parseInt(h.tagName.charAt(1), 10);\n      var n = document.createElement('h' + Math.max(3, lvl - 1));\n      n.className = (h.className ? h.className + ' ' : '') + 'h' + lvl; // keep the original visual size\n      if (h.id) { n.id = h.id; }\n      n.setAttribute('data-rh8377', '1');\n      n.innerHTML = h.innerHTML;\n      h.parentNode.replaceChild(n, h);\n    }\n  }\n  function run() { try { relevel(); } catch (e) {} }\n  run();\n  if (window.MutationObserver) {\n    var deb;\n    new MutationObserver(function () { clearTimeout(deb); deb = setTimeout(run, 150); })\n      .observe(document.documentElement, { childList: true, subtree: true });\n  }\n})();\n</script>\n<script>\n(function () {\n  /* PRD-8377 (QA follow-up): the company-configured careers content\n     (config.custom_careersite_text, rendered raw into the company-info panel on\n     #detail/#list) can embed an <iframe> with no title, failing \"frames must have a\n     title\" (WCAG 4.1.2 / 2.4.1). Give EVERY title-less iframe on the career page an\n     accessible name: video embeds get \"<company> video\", any other embed gets a\n     generic \"Embedded content\". The functional PRD-6611 consent iframe already ships\n     a static title (dpdpConsentModal.tpl) so it is not title-less and is left as-is.\n     Runs on load and re-runs on SPA re-render. Only the title attribute is set. */\n  var COMPANY = ('Axis Securities Limited' || '').trim();\n  var VIDEO = /(?:youtube\\.com|youtu\\.be|vimeo\\.com|player\\.|\\/embed\\/)/i;\n  function titleFrames() {\n    var frames = document.querySelectorAll('iframe:not([title])');\n    for (var i = 0; i < frames.length; i++) {\n      var src = frames[i].getAttribute('src') || '';\n      var name = VIDEO.test(src)\n        ? (COMPANY ? (COMPANY + ' video') : 'Company video')\n        : 'Embedded content';\n      frames[i].setAttribute('title', name);\n    }\n  }\n  function run() { try { titleFrames(); } catch (e) {} }\n  run();\n  if (window.MutationObserver) {\n    var deb;\n    new MutationObserver(function () { clearTimeout(deb); deb = setTimeout(run, 150); })\n      .observe(document.documentElement, { childList: true, subtree: true });\n  }\n})();\n</script>\n<div class=\"wrapper page-height\">\n    <div id=\"header-wrapper\"></div>\n    <div id=\"app-wrapper\" style=\"min-height: 500px\"></div>\n    <script src=\"/candidate/candresource/candidate/vendor/blueimp-gallery.min.js \"></script>\n    <script data-main=\"./candresource/candidate/require_main.js\"\n            src=\"./candresource/candidate/vendor/require.js\"></script>\n    <div class=\"clearfix\"></div>\n    <input type=\"hidden\" id=\"token\" value=\"aA6ANFk4CHLUkuOVBmxq\"/>\n    <input type=\"hidden\" id=\"source\" value=\"CAREERSITE\"/>\n    <input type=\"hidden\" id=\"shareToken\" value=\"u69C6LsahgC9xBrQlH1G\"/>\n    <input type=\"hidden\" id=\"redirectHash\" value=\"\"/>\n    <input type=\"hidden\" id=\"facebookShareMsg\" value=\"Apply Now! This is a wonderful opportunity. Help your friends by sharing this role with them.\"/>\n    <input type=\"hidden\" id=\"linkedInShareMsg\" value=\"Apply Now! This is a wonderful opportunity. Help your friends by sharing this role with them.\"/>\n    <input type=\"hidden\" id=\"twitterShareMsg\" value=\"<twitter_handle> is hiring for <job_title> | . Apply Now!\"/>\n    <input type=\"hidden\" id=\"lang\" value=\"en\"/>\n    <div class=\"clear\"></div>\n    <div class=\"PD24\"></div>\n    <div id=\"footer-wrapper\"></div>\n\n</div>\n\n<div>\n\t\t\t\n</div>\n</html>\n",
