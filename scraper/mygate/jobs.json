    "jobDescription": "<p style=\"margin:0in;font-family:Calibri;font-size:20pt;\"><span style=\"font-weight:bold;\" lang=\"en-in\" xml:lang=\"en-in\">Role: </span><span style=\"font-weight:bold;\" lang=\"en-us\" xml:lang=\"en-us\">Product Analyst</span></p><p style=\"margin:0in;font-size:11pt;\"><span style=\"font-family:'Segoe UI Emoji';\" lang=\"en-in\" xml:lang=\"en-in\">📍 </span><span style=\"font-family:Calibri;\" lang=\"en-us\" xml:lang=\"en-us\">Location: Bangalore</span></p><p style=\"margin:0in;font-size:11pt;\"><span style=\"font-family:'Segoe UI Emoji';\" lang=\"en-in\" xml:lang=\"en-in\">💼 </span><span style=\"font-family:Calibri;\" lang=\"en-us\" xml:lang=\"en-us\">Experience: Minimum </span><span style=\"font-weight:bold;font-family:Calibri;\" lang=\"en-us\" xml:lang=\"en-us\">1+ year</span></p><p style=\"margin:0in;font-size:11pt;\"><span style=\"font-family:'Segoe UI Emoji';\" lang=\"en-in\" xml:lang=\"en-in\">🧑‍💻 </span><span style=\"font-family:Calibri;\" lang=\"en-us\" xml:lang=\"en-us\">Function: Product / Analytics</span></p><p style=\"margin:0in;font-family:Calibri;font-size:11pt;\"><span lang=\"en-in\" xml:lang=\"en-in\">We </span><span lang=\"en-us\" xml:lang=\"en-us\">are looking for a </span><span style=\"font-weight:bold;\" lang=\"en-us\" xml:lang=\"en-us\">highly analytical and problem-solving oriented Product Analyst</span><span lang=\"en-us\" xml:lang=\"en-us\"> who can work closely with product managers to identify opportunities, analyze product performance, and drive data-backed decisions.</span></p><p style=\"margin:0in;font-family:Calibri;font-size:11pt;\"><span lang=\"en-in\" xml:lang=\"en-in\">The </span><span lang=\"en-us\" xml:lang=\"en-us\">ideal candidate should demonstrate </span><span style=\"font-weight:bold;\" lang=\"en-us\" xml:lang=\"en-us\">strong product thinking, structured problem solving, and deep analytical ability</span><span lang=\"en-us\" xml:lang=\"en-us\"> to understand user behavior and improve product outcomes.</span></p><p style=\"margin:0in;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\"> </p><p style=\"margin:0in;font-family:Calibri;font-size:20pt;\"><span style=\"font-weight:bold;\" lang=\"en-in\" xml:lang=\"en-in\">Key </span><span style=\"font-weight:bold;\" lang=\"en-us\" xml:lang=\"en-us\">Responsibilities</span></p><ul type=\"disc\" style=\"margin-top:0in;margin-bottom:0in;\"> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Analyze </span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">product usage data to identify trends, patterns, and opportunities for improvement.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Work </span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">closely with </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">product managers, engineers, and designers</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\"> to support product strategy and feature development.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Define </span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">and track </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">product metrics, KPIs, and success benchmarks</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Conduct </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">deep-dive analysis</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\"> to diagnose product performance issues.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Build </span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">dashboards and reports to monitor product health.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Identify </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">user pain points</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\"> and recommend product improvements.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Support </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">A/B testing and experimentation frameworks</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">.</span></li> <li style=\"margin-top:0;margin-bottom:0;vertical-align:middle;\"><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-in\" xml:lang=\"en-in\">Translate </span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">data insights into </span><span style=\"font-weight:bold;font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">clear product recommendations</span><span style=\"font-family:Calibri;font-size:11pt;\" lang=\"en-us\" xml:lang=\"en-us\">.</span></li> <li style=\"margin-top:0;ma