 margin-top: 13px;\n      }\n\n      #responsiveCenterRow {\n        height: 100%;\n        display: flex;\n        align-items: center;\n        justify-content: space-around;\n      }\n\n      .styledAnchor a {\n        color: var(--primary-color);\n        text-decoration: none;\n      }\n\n      .styledAnchor a:hover {\n        color: var(--secondary-color);\n        filter: brightness(var(--filter-brightness));\n        text-decoration: none;\n      }\n\n      /* Extra small devices (phones, 600px and down) */\n      @media only screen and (max-width: 600px) {\n        /* Since Ant Design has a 24 Grids System, 20 Grids => 20 / 24 * 100 = 83.33% */\n        #responsiveCenterColumn {\n          width: 83.33%;\n        }\n      }\n\n      /* Small devices (portrait tablets and large phones, 600px and up) */\n      @media only screen and (min-width: 600px) {\n        /* Since Ant Design has a 24 Grids System, 20 Grids => 20 / 24 * 100 = 83.33% */\n        #responsiveCenterColumn {\n          width: 83.33%;\n        }\n      }\n\n      /* Medium devices (landscape tablets, 768px and up) */\n      @media only screen and (min-width: 768px) {\n        /* Since Ant Design has a 24 Grids System, 16 Grids => 16 / 24 * 100 = 66.66% */\n        #responsiveCenterColumn {\n          width: 66.66%;\n        }\n      }\n\n      /* Large devices (laptops/desktops, 992px and up) */\n      @media only screen and (min-width: 992px) {\n        /* Since Ant Design has a 24 Grids System, 16 Grids => 10 / 24 * 100 = 41.66% */\n        #responsiveCenterColumn {\n          width: 41.66%;\n        }\n      }\n\n      /* Extra large devices (large laptops and desktops, 1200px and up) */\n      @media only screen and (min-width: 1200px) {\n        /* Since Ant Design has a 24 Grids System, 16 Grids => 6 / 24 * 100 = 25% */\n        #responsiveCenterColumn {\n          width: 25%;\n        }\n      }\n\n      .responsiveCenterContent {\n        text-align: center;\n        font-size: 36px;\n      }\n\n      /* Styling for footer end */\n\n      /* Fonts begin */\n\n      @font-face {\n        font-family: 'Geist';\n        font-weight: 500;\n        font-style: normal;\n        font-display: fallback; /* Read next point */\n        src: local('Geist'),\n          url('/fonts/SF-Pro-Display-Medium.otf') format('opentype');\n      }\n\n      @font-face {\n        font-family: 'Geist';\n        font-weight: 600;\n        font-style: normal;\n        font-display: fallback; /* Read next point */\n        src: local('Geist'),\n          url('/fonts/SF-Pro-Display-Semibold.otf') format('opentype');\n      }\n\n      @font-face {\n        font-family: 'Geist';\n        font-style: normal;\n        font-display: fallback; /* Read next point */\n        src: local('Geist'),\n          url('/fonts/SF-Pro-Display-Regular.otf') format('opentype');\n      }\n\n      ::-webkit-scrollbar {\n        width: 7px;\n        height: 10px;\n      }\n\n      ::-webkit-scrollbar-thumb {\n        border-radius: 10px;\n        background-color: #5a6585;\n      }\n\n      .ql-size-huge {\n        font-size: 2.5em;\n      }\n\n      .ql-size-large {\n        font-size: 1.5em;\n      }\n    \n      .ql-size-small {\n        font-size: 0.75em;\n      }\n      /* Fonts end */\n    </style>\n  </head>\n  <body style=\"margin: 0;\">\n    <noscript>\n      <iframe\n        src=\"https://www.googletagmanager.com/ns.html?id=GTM-55LJ6SC\"\n        height=\"0\"\n        width=\"0\"\n        style=\"display:none;visibility:hidden\"\n      >\n      </iframe>\n    </noscript>\n    <noscript>\n      If you're seeing this message, that means\n      <strong>JavaScript has been disabled on your browser</strong>, please\n      <strong>enable JS</strong> to make this app work.\n    </noscript>\n    <div class=\"jobDetailsContainer\">\n      <!-- Header begin -->\n      <div class=\"careerHeader\">\n        <div class=\"careerHeaderBody\">\n          <div id=\"headerLoader\" style=\"display: none;\"></div>\n          <img id=\"companyLogo\" src=\"https://storage.googleapis.com/hire-backend-rails-production/legacy/platform-production-img-bucket/prod/ea6dc336494044d89e9a6b935efa8841/Static/ec545d02d54945a6addceecec72c8004.svg\" style=\"max-height: 50px;\" />\n          <div id=\"companyName\" style=\"display: none;\"></div>\n        </div>\n      </div>\n      <!-- Header end -->\n\n      <!-- CareerDetailsPage begin -->\n      <div class=\"styledResult\" id=\"invalidJob\" style=\"display: none;\">\n        <div id=\"invalidResultIcon\">\n          <svg\n            viewBox=\"64 64 896 896\"\n            focusable=\"false\"\n            class=\"\"\n            data-icon=\"warning\"\n            width=\"1em\"\n            height=\"1em\"\n            fill=\"#FAAD14\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M955.7 856l-416-720c-6.2-10.7-16.9-16-27.7-16s-21.6 5.3-27.7 16l-416 720C56 877.4 71.4 904 96 904h832c24.6 0 40-26.6 27.7-48zM480 416c0-4.4 3.6-8 8-8h48c4.4 0 8 3.6 8 8v184c0 4.4-3.6 8-8 8h-48c-4.4 0-8-3.6-8-8V416zm32 352a48.01 48.01 0 0 1 0-96 48.01 48.01 0 0 1 0 96z\"\n            ></path>\n          </svg>\n        </div>\n        <div id=\"invalidResultTitle\">\n          Sorry! This job is no longer accepting applications.\n        </div>\n        <div id=\"invalidResultExtra\">\n            <button id=\"viewMoreJobs\"></button>\n        </div>\n      </div>\n\n      <div class=\"jobListContainer\" id=\"jobListContainer\">\n        <div class=\"jobsHeaderCareerDetails\">Job Details</div>\n        <div class=\"jobTitle\">Regional Operation Manager</div>\n        <div class=\"jobPropertyContainer\">\n          <div class=\"jobProperty\" id=\"jobPropertyOne\">Delhi, NCT, India</div>\n          <div class=\"jobProperty\" id=\"jobPropertyTwo\">Operations</div>\n          <div class=\"jobProperty\" id=\"jobPropertyThree\">Full Time</div>\n        </div>\n        <div class=\"jobParaHeading\">Description</div>\n        <div class=\"jobParaContent\" id=\"jobParaContent\"><p><strong style=\"color: black;\">About Organization</strong></p><p>&nbsp;</p><p><span style=\"color: black;\">LetsTransport was founded in 2015 by IIT-Kharagpur alumni. It is a series-B funded, last-mile tech-logistics solution provider for intra-state deliveries head-quartered in Bangalore. It offers reliable, affordable, and professional services, structured to serve enterprises. LetsTransport aggregates light commercial vehicles for urban logistics and has onboarded 100,000+ truckers on its platform across 17 cities. LetsTransport works across industry sectors like organized retail, FMCG and e-commerce, distribution and 3PL companies. Some of its clients include Amazon, Britannia, Nestle, Bisleri, Vishal Mega Mart, JSW, ACC, Coca-Cola, Delhivery, and Udaan. The company offers customized logistics solutions for clients, along with other value-added services such as screened drivers, audited and GPS-enabled vehicles, point-to-point billing, status updates, 24x7 service, and greater efficiency, all at transparent and economical pricing.</span></p><p>&nbsp;</p><p><span style=\"color: black;\">At LetsTransport, we have a singular mission to transform urban logistics in India through technology. We are backed by marquee investors like Bertelsmann, Fosun, Mitsubishi, Rebright Partners and Mitsui Sumitomo Insurance Venture Capital.</span></p><p>&nbsp;</p><p><a href=\"https://letstransport.in/\" rel=\"noopener noreferrer\" target=\"_blank\">https://letstransport.in/</a></p><p>&nbsp;</p><p><strong>Designation – </strong><strong style=\"color: rgb(34, 34, 34);\">Regional Operations Manager – North India</strong></p><p><strong>Experience – 4-8 Years</strong></p><p><strong>Job Location – New Delhi (Will be responsible for whole North India for LT including Punjab, Delhi NCR, UP, Rajasthan, MP, Chhattisgarh)</strong></p><p><strong style=\"color: rgb(34, 34, 34);\">&nbsp;</strong></p><p><strong style=\"color: rgb(34, 34, 34);\">About the role</strong></p><p><strong style=\"color: rgb(34, 34, 34);\">&nbsp;</strong></p><p><span style=\"color: black;\">This role calls for an individual who can own all aspects of operations of a region for Lets Transport. </span></p><p><span style=\"color: black;\">The person should have high drive to meet targets and should be able to handle large geographical team effectively. Candidate will be working closely with Regional head and National Operations Manager towards creating a high performing team which can deliver targets for a high growth company. </span></p><p><strong style=\"color: rgb(34, 34, 34);\">&nbsp;</strong></p><p><strong style=\"color: black;\">Roles &amp; Responsibilities:</strong></p><p><span style=\"color: rgb(34, 34, 34);\">&nbsp;</span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Responsible for all day to day operations for the region </span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Work closely with Business development team and supply team to ensure the client expectations are properly met by operations team</span><span style=\"color: black;\"> </span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Build and develop the required team to achieve the targets</span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Drive operational efficiencies to maintain Service levels and expand margins of the region. </span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Build and implement processes to increase the overall efficiency and reliability of the region</span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Participate in cross-functional projects for high priority initiatives and bring process and data-driven focused approach to support the organization's goals.</span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Drive change management to ensure efficient implementations of any new strategic change. </span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Collaborate closely with stakeholders like Finance, Product, Sales and New initiatives with the objective to drive stakeholder success</span></p><p><span style=\"color: rgb(34, 34, 34);\">·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style=\"color: black;\">Ensure excellent customer and partner experience </span></p><p><strong>KPIs:</strong></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Fulfilment rates for the region</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Margin for the region </p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Internal Quality metrics – (SLAs %)</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Customer and Partner Success metrics – (Customer NPS, Partner NPS)</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Internal team productivity metrics (Operations cost per transaction)</p><p>&nbsp;</p><p><strong style=\"color: black;\">Requisites / Prerequisites:</strong></p><p>&nbsp;</p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">Graduates from Tier 1/2 Engineering colleges/Post Graduate from Tier 1/2 Management colleges with good academic performance. </span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">4-8 years of frontline Operation or P&amp;L Management </span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">Strong leadership qualities to lead a large geographically spread team</span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">Ability to manage conflicts and good stakeholder management skills </span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">Multi-tasking capabilities and inter departmental coordination</span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">Product first mindset and relevant experience is a useful plus</span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">A strong team sport background is a plus (showcasing the long term commitment and rigor). </span></p><p>·&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color: black;\">KPIs Handled: Delivery Fulfilment/ Service levels, cost related KPIs, Revenue growth and Margin KPIs, project management, Process or change management</span></p><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p><p><strong>Preferred Industries:</strong> FMCG, Logistics, Hospitality, Mobility, Manufacturing, Retail, Ecommerce</p><p>&nbsp;</p></div>\n        <div class=\"jobDetailsActionContainer\">\n          <a id=\"applyJobButton\" href=\"\">\n            <button class=\"styledButton\" style=\"cursor: pointer;\">Apply For This Job</button>\n          </a>\n          </a>\n          <div class=\"styledLink\">\n            <a id=\"browseMoreJobs\" href=\"https://hire.auzmor.com/letstransport/careers\" style=\"display: flex; align-items: center;\">\n              <img\n                src=\"/images/chevronLeft.svg\"                \n              />\n              &nbsp;Browse more Jobs\n            </a>\n          </div>\n        </div>\n      </div>\n      <!-- CareerDetailsPage end -->\n\n      <!-- Footer begin -->\n      <div class=\"footerContainer\">\n        <div class=\"row\" id=\"responsiveCenterRow\">\n          <div class=\"col\" id=\"responsiveCenterColumn\">\n            <div class=\"responsiveCenterContent\">\n              <!-- Footer content begin -->\n              <div>\n                <div class=\"footerDetailsWebsite styledAnchor\">\n                  <a id=\"footerViewWebsite\" href=\"https://letstransport.in/\" target=\"_blank\">\n                    View website\n                    <img\n                      src=\"/images/externallink.svg\"\n                      style=\"height: 14px; width: 17px;\"\n                    />\n                  </a>\n                </div>\n                <div class=\"footerDetailsDescription styledAnchor\">\n                  Powered by\n                  <a href=\"https://auzmor.com/hire/\" target=\"_blank\">\n                    Auzmor Hire\n                  </a>\n                </div>\n              </div>\n              <!-- Footer content end -->\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <!-- Footer end -->\n    <!-- Adding scripts here so that the scripts run after all the HTML elements have loaded -->\n    <script>\n      // Apply Job Link button\n      const applyJobLink = document.getElementById('applyJobButton');\n      let initialURL = window.location.href;\n      let applyJobURL = `${window.location.href}/apply`;\n      let indexOfQuestionMark = initialURL.lastIndexOf('?');\n      if(indexOfQuestionMark > -1){\n        applyJobURL =  initialURL.substr(0, indexOfQuestionMark) + \"/apply\" + initialURL.substr(indexOfQuestionMark);\n      }\n      applyJobLink.href = applyJobURL;      \n            \n      // Get tags with style and modify color to inherit\n      let elements = document.getElementById(\"jobParaContent\").querySelectorAll(\"*[style]\");\n      for (element of elements){\n        element.style.color = \"inherit\";\n      }\n\n    </script>\n  </body>\n</html>\n"
