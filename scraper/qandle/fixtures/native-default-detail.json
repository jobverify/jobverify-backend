    "body": "<div class=\"panel-box\">\n    <div class=\"panel-box-body recruit_application\">\n        <div layout-padding class=\"md-subhead b\">\n            <div class=\"rows\">\n                <ul class=\"q-breadcrumb no-margin\">\n                    <li role=\"button\" tabindex=\"0\" ng-click=\"goTojobs()\" ng-hide=\"jobId\">\n                        <md-icon class=\"material-icons blue\">arrow_back</md-icon>\n                    </li>\n                    <li role=\"button\" tabindex=\"0\">\n                        <span class=\"blue\" ng-click=\"goTojobs()\">\n                            <span ng-if=\"envMnt != 'nividous'\">\n                                {{'COMMON.OPENING_JOB' | translate }}\n                            </span>\n                            <span ng-if=\"envMnt === 'nividous'\">\n                                Job Opening\n                            </span>\n                        </span>\n                    </li>\n                    <li><i class=\"fa fa-angle-double-right\"></i></li>\n                    <li role=\"button\" tabindex=\"0\">\n                        <span class=\"ng-binding\">{{'COMMON.DESCRIPTION' | translate }}</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"blue-bg\" style=\"min-height: 150px;\"></div>\n\n        <div class=\"recruit_openJob md-padding\">\n            <div layout-gt-sm=\"row\" layout-align=\"start center\">\n                <div flex class=\"md-subhead b\">{{jobsObject.selectedJob.job_title.value}}</div>\n                <!-- <div flex class=\"md-subhead b\">{{jobsObject.selectedJob.job_post_date}}</div> -->\n                <div flex class=\"md-subhead b\">{{jobsObject.selectedJob.location}}</div>\n                <div flex class=\"md-subhead b\">{{jobsObject.selectedJob.employment_type}}</div>\n                <div flex class=\"md-subhead b\" ng-if=\"!jobsObject.accessToken && upButtonStatus\">\n                    <md-button class=\"md-raised\"\n                        ng-click=\"applyJob(false, policies)\">\n                        {{'COMMON.APPLY_NOW' | translate }}\n                    </md-button>\n                </div>\n                <div flex=\"25\" layout=\"row\" layout-align=\"start center\" class=\"md-subhead b lm-xs-w100\"\n                    ng-if=\"jobsObject.accessToken\">\n                    <md-button class=\"md-raised white-bg\" ng-if=\"jobsObject.jobDetails.head.internal_job_post && upButtonStatus\"\n                        ng-click=\"applyJob(false, policies)\"> {{'COMMON.APPLY_NOW' |\n                        translate }}\n                    </md-button>\n                    <md-button class=\"md-raised md-primary\" ng-click=\"applyJob(true)\"\n                        ng-if=\"user.accessToken && jobsObject.jobDetails.head.is_refer_someone && upButtonStatus\">{{'COMMON.REFER_SOMEONE'\n                        | translate }}\n                    </md-button>\n                </div>\n            </div>\n            <md-card class=\"no-margin\">\n                <md-card-content class=\"md-padding\">\n                    <div ng-if=\"jobsObject.jobDetails.head.requisition_id\">\n                        <p class=\"md-subhead b\">{{jobsObject.jobDetails.head.requisition_id.name}}:</p>\n                        <div class=\"rows\">\n                            {{jobsObject.jobDetails.head.requisition_id.value}}\n                        </div>\n                    </div>\n                    <div ng-repeat=\"details in jobsObject.jobDetails.body\">\n                        <p class=\"md-subhead b\">{{details.name}}:</p>\n                        <div class=\"rows\" ng-if=\"details.field_type != 13 \n                            && details.slug != 'job_description'\"> {{details.value}}\n                        </div>\n                        <div class=\"rows\" ng-if=\"details.slug == 'job_description'\">\n                            <span class=\"list_type_wrap\"\n                                ng-bind-html=\"renderContentUsingHtmlTagBroadcast(details.value)\"></span>\n                        </div>\n                        <div class=\"rows\" ng-if=\"details.field_type == 13\">\n                            <div class=\"qmchips\" layout=\"row\" layout-align=\"start center\">\n                                <div class=\"qmchip\" ng-repeat=\"auth in details.value\">\n                                    <img ng-src=\"{{auth.profile_pic}}\" alt=\"\">\n                                    <span class=\"text\" style=\"margin:4px;\" layout=\"column\">\n                                        <p>{{auth.full_name}}</p>\n                                        <small ng-repeat=\"empd in auth.display_detail track by $index\"\n                                            ng-if=\"$index != 0\">{{empd}}</small>\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"clearfix\"></div>\n                    <div ng-if=\"!jobsObject.accessToken\">\n                        <div layout=\"column\" layout-align=\"start start\">\n                            <div layout-gt-sm=\"row\" layout-align=\"start center\" class=\"inline-switch\" ng-if=\"policie\">\n                                <md-checkbox class=\"md-primary mb-0\" ng-model=\"policies.termsNcondition.check\">\n                                    {{'COMMON.I_AGREE_TO_TTAC' | translate }} &nbsp;\n                                </md-checkbox>\n                                <div class=\"jobs_terms_condition\" ng-click=\"openTermsAndPolicyPopup()\">\n                                    {{'COMMON.CLICK_HTRTC' | translate }}\n                                </div>\n                            </div>\n                            <div class=\"clearfix\"></div>\n                            <div layout-gt-sm=\"row\" layout-align=\"start center\" class=\"inline-switch\" ng-if=\"RetentionPolicy\">\n                                <md-checkbox class=\"md-primary mb-0\" ng-model=\"policies.dataRetention.check\">\n                                    {{'COMMON.I_AGREE_TODRPMPD' | translate }} &nbsp;\n                                </md-checkbox>\n                                <div class=\"jobs_terms_condition\" ng-click=\"openDataRetentionPopup()\">\n                                    {{'COMMON.CLICK_HTRDRP' | translate }}\n                                </div>\n                            </div>\n                            <div class=\"clearfix\"></div>\n                            <p class=\"sb_i\" ng-if=\"(policie && RetentionPolicy) || (policie || RetentionPolicy) && !(policie && RetentionPolicy)\">{{'COMMON.PLEASE_RTDRP&TC' | translate\n                                }}</p>\n\n                            <md-button class=\"md-raised md-primary\" ng-if=\"(!policie && !RetentionPolicy)\"\n                                ng-click=\"applyJob(false, policies)\">\n                                {{'COMMON.APPLY_NOW' | translate }}\n                            </md-button>\n\n                            <span ng-if=\"(policie && RetentionPolicy)\">\n                                <md-button class=\"md-raised md-primary\"\n                                    ng-disabled=\"!(policies.termsNcondition.check && policies.dataRetention.check)\"\n                                    ng-click=\"applyJob(false, policies)\">\n                                    {{'COMMON.APPLY_NOW' | translate }}\n                                </md-button>\n                            </span>\n                            <span ng-if=\"(policie || RetentionPolicy) && !(policie && RetentionPolicy)\">\n                                <md-button class=\"md-raised md-primary\"\n                                    ng-disabled=\"!(policies.dataRetention.check || policies.termsNcondition.check) \"\n                                    ng-click=\"applyJob(false, policies)\">\n                                    {{'COMMON.APPLY_NOW' | translate }}\n                                </md-button>\n                            </span>\n\n                        </div>\n                    </div>\n                    <div ng-if=\"jobsObject.accessToken\">\n                        <div layout=\"column\" layout-align=\"start start\">\n                            <div layout-gt-sm=\"row\" layout-align=\"start center\" class=\"inline-switch\">\n                                <md-checkbox class=\"md-primary mb-0\" ng-model=\"policies.termsNcondition.check\"\n                                    ng-change=\"policyTermUpChange(policies)\">\n                                    {{'COMMON.I_AGREE_TO_TTAC' | translate }} &nbsp;\n                                </md-checkbox>\n                                <div class=\"jobs_terms_condition\" ng-click=\"openTermsAndPolicyPopup()\">\n                                    {{'COMMON.CLICK_HTRTC' | translate }}\n                                </div>\n                            </div>\n                            <div class=\"clearfix\"></div>\n                            <div layout-gt-sm=\"row\" layout-align=\"start center\" class=\"inline-switch\">\n                                <md-checkbox class=\"md-primary mb-0\" ng-model=\"policies.dataRetention.check\"\n                                    ng-change=\"policyTermUpChange(policies)\">\n                                    {{'COMMON.I_AGREE_TODRPMPD' | translate }} &nbsp;\n                                </md-checkbox>\n                                <div class=\"jobs_terms_condition\" ng-click=\"openDataRetentionPopup()\">\n                                    {{'COMMON.CLICK_HTRDRP' | translate }}\n                                </div>\n                            </div>\n                            <div class=\"clearfix\"></div>\n                            <p class=\"sb_i\">{{'COMMON.PLEASE_RTDRP&TC' | translate }}</p>\n                            <md-button class=\"md-raised md-primary\" ng-if=\"jobsObject.jobDetails.head.internal_job_post\"\n                                ng-disabled=\"!(policies.termsNcondition.check && policies.dataRetention.check)\"\n                                ng-click=\"applyJob(false, policies)\"> {{'COMMON.APPLY_NOW' | translate }}\n                            </md-button>\n                            <md-button ng-if=\"user.accessToken && !jobId\n                                && jobsObject.jobDetails.head.is_refer_someone\" class=\"md-raised md-primary\"\n                                ng-click=\"applyJob(true)\"> {{'COMMON.REFER_SOMEONE' | translate }}\n                            </md-button>\n                        </div>\n                    </div>\n                </md-card-content>\n            </md-card>\n        </div>\n    </div>\n</div>\n\n<ng-include src=\"getPartial('common', 'jobs/termsNcondition.html')\">\n</ng-include>"
  }
