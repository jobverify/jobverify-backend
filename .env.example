# MongoDB keys
PORT=5290
MONGO_URI=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
NODE_ENV=development
NODE_OPTIONS=--openssl-legacy-provider

# Google signin
GOOGLE_CLIENT_ID=

# Github Action workflow Pipeline keys
# Admin schedule editing also requires Contents + Workflows write permissions
# (classic PAT: repo + workflow scopes) and permission to commit to the default branch.
GITHUB_PAT=
GITHUB_REPO=jobverify/jobverify-backend
SCRAPER_CONCURRENCY=10
WORKDAY_DETAIL_FETCH_CONCURRENCY=1
TRUST_PROXY=1

# Public job browsing abuse guard
PUBLIC_JOB_ABUSE_PAGE_WALK_WINDOW_MS=60000
PUBLIC_JOB_ABUSE_PAGE_WALK_LIMIT=30
PUBLIC_JOB_ABUSE_DETAIL_WINDOW_MS=60000
PUBLIC_JOB_ABUSE_DETAIL_LIMIT=90
PUBLIC_JOB_ABUSE_VIOLATION_WINDOW_MS=900000
PUBLIC_JOB_ABUSE_VIOLATION_LIMIT=5
PUBLIC_JOB_ABUSE_BLOCK_MS=900000
PUBLIC_JOB_ABUSE_MAX_RECORDS=5000

# Email verification using SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudflare Trunstile captcha keys
TURNSTILE_SECRET_KEY=
#0x4AAAAAAERupRubdcfU0AmzszzdzfUsieI
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_EXPECTED_ACTION=login

# Razorpay payment gateway
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Telegram Alert Bot
TELEGRAM_BOT_USERNAME=jobverifying_bot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Local CPU description rewriting (GitHub Actions defaults to publish)
JOB_DESCRIPTION_REWRITE_MODE=off
JOB_DESCRIPTION_REWRITE_BUDGET_SECONDS=1200
JOB_DESCRIPTION_REWRITE_CPU_THREADS=2
JOB_DESCRIPTION_REWRITE_CONCURRENCY=1
# Optional compatible GPU runtime; default remains the pinned CPU build.
JOB_DESCRIPTION_REWRITE_GPU_LAYERS=0
JOB_DESCRIPTION_REWRITE_BINARY=
JOB_DESCRIPTION_REWRITE_BINARY_SHA256=

# Enable only on the backend running on your own PC. Uses this backend's MONGO_URI.
PIPELINE_LOCAL_ENABLED=false

# Tailored resumes run a local model in tailored-resumes.yml, with no inference API.
# Uses GITHUB_PAT / GITHUB_REPO above and the repository's MONGO_URI Actions secret.
# Available when GitHub credentials are configured; set false to disable dispatch.
TAILORED_RESUME_ACTIONS_ENABLED=true
TAILORED_RESUME_ACTIONS_MONTHLY_RUN_LIMIT=10
